<?xml version="1.0" encoding="utf-8"?>
<!-- Заведён в Phase 13. Фиксирует основной источник пакетов явно, чтобы восстановление на CI и
     на чистой машине не зависело от машинного %AppData%\NuGet\NuGet.Config. Без <clear/> —
     локальные источники разработчика (если заданы на уровне пользователя) продолжают работать.
     Velopack 1.2.0 и тосты CommunityToolkit тянутся с nuget.org. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
