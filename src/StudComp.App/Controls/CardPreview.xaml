<UserControl x:Class="StudComp.Controls.CardPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:StudComp.Behaviors"
             xmlns:controls="clr-namespace:StudComp.Controls"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=controls:CardPreviewViewModel}"
             d:DesignHeight="600" d:DesignWidth="320">

    <Grid>
        <!-- Пустое состояние — не пустота, а подсказка, что делать дальше (new_addons.md §8.5). -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                    Visibility="{Binding HasCard, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
            <ui:SymbolIcon Symbol="ContentView24" FontSize="32" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Выберите карточку — здесь будут обе стороны, метки и правка на месте." />
        </StackPanel>

        <Grid Visibility="{Binding HasCard, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка: вид карточки и быстрые действия. -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="{Binding KindIcon}" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding SelectedKind.Display}" Margin="8,0,0,0" FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Appearance="Transparent" Padding="6" ToolTip="Закрепить (F)"
                               Icon="{ui:SymbolIcon Pin24}" Command="{Binding TogglePinCommand}" />
                    <ui:Button Appearance="Transparent" Padding="6" ToolTip="Отложить (S)"
                               Icon="{ui:SymbolIcon Pause24}" Command="{Binding ToggleSuspendCommand}" />
                    <ui:Button Appearance="Transparent" Padding="6" ToolTip="Править (E)"
                               Icon="{ui:SymbolIcon Edit24}" Command="{Binding BeginEditCommand}"
                               Visibility="{Binding IsEditing, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />
                    <ui:Button Appearance="Transparent" Padding="6" ToolTip="Готово (Ctrl+Enter)"
                               Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding EndEditCommand}"
                               Visibility="{Binding IsEditing, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Лицевая сторона. -->
                    <TextBlock Text="Лицевая сторона" FontSize="11" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <TextBlock Text="{Binding Front}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                               Visibility="{Binding IsEditing, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />
                    <ui:TextBox Text="{Binding Front, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="False" FontSize="15"
                                Visibility="{Binding IsEditing, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

                    <Separator Margin="0,12,0,12" Background="{DynamicResource ControlElevationBorderBrush}" />

                    <!-- Оборот: в просмотре размечен Markdown, в правке — исходный текст. -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Оборот" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <ui:Button Grid.Column="1" Appearance="Secondary" Padding="6,2"
                                   Command="{Binding ShowMarkdownHelpCommand}"
                                   ToolTip="Подсказка по разметке Markdown"
                                   Icon="{ui:SymbolIcon QuestionCircle24}"
                                   Visibility="{Binding IsEditing,
                                                Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                    </Grid>

                    <FlowDocumentScrollViewer Document="{Binding BackDocument}" MaxHeight="320"
                                              VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
                                              Padding="0" Margin="0,0,0,4"
                                              Visibility="{Binding IsEditing, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />
                    <ui:TextBox Text="{Binding Back, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="320"
                                behaviors:MarkdownEditingBehavior.IsEnabled="True"
                                VerticalScrollBarVisibility="Auto" FontSize="13"
                                Visibility="{Binding IsEditing, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

                    <!-- Подсказка: в просмотре показывается, только если она есть. -->
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEditing}" Value="False" />
                                            <Condition Binding="{Binding HasHint}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Подсказка" FontSize="11" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding Hint}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding IsEditing, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />
                        <ui:TextBox Text="{Binding Hint, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Показывается до ответа" FontSize="12"
                                    Visibility="{Binding IsEditing, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                    </StackPanel>

                    <!-- Метки чипами с автодополнением. -->
                    <TextBlock Text="Метки" FontSize="11" Margin="0,14,0,4"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <controls:TagChipsEditor x:Name="TagsEditor" Tags="{Binding Tags}"
                                             Suggestions="{Binding TagSuggestions}" />

                    <!-- Привязки правятся всегда: это выбор из списка, а не набор текста. -->
                    <TextBlock Text="Предмет" FontSize="11" Margin="0,14,0,4"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ComboBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"
                              DisplayMemberPath="Name" />

                    <TextBlock Text="Колода" FontSize="11" Margin="0,10,0,4"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ComboBox ItemsSource="{Binding Decks}" SelectedItem="{Binding SelectedDeck, Mode=TwoWay}"
                              DisplayMemberPath="Name" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Вид" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                                      DisplayMemberPath="Display" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Сложность" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ComboBox ItemsSource="{Binding Difficulties}"
                                      SelectedItem="{Binding SelectedDifficulty, Mode=TwoWay}"
                                      DisplayMemberPath="Display" />
                        </StackPanel>
                    </Grid>

                    <!-- Источник: откуда взято. -->
                    <StackPanel Margin="0,14,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEditing}" Value="False" />
                                            <Condition Binding="{Binding HasSource}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Источник" FontSize="11" Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding Source}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding IsEditing, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />
                        <ui:TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Лекция 12.09, Демидович §4.2" FontSize="12"
                                    Visibility="{Binding IsEditing, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                    </StackPanel>

                    <!-- Состояние повторения и служебные даты. -->
                    <Border Margin="0,16,0,0" CornerRadius="8" Padding="10,8"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBlock Text="{Binding ReviewText}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding MetaText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Подвал: статус автосохранения и необратимых действий здесь нет — только корзина. -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <ui:Button Grid.Column="1" Appearance="Secondary" Padding="10,4" FontSize="12"
                           Icon="{ui:SymbolIcon Delete24}" Content="В корзину"
                           Command="{Binding MoveToTrashCommand}"
                           Visibility="{Binding IsDeleted, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />
                <ui:Button Grid.Column="1" Appearance="Primary" Padding="10,4" FontSize="12"
                           Icon="{ui:SymbolIcon ArrowUndo24}" Content="Вернуть"
                           Command="{Binding RestoreCommand}"
                           Visibility="{Binding IsDeleted, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
            </Grid>
        </Grid>
    </Grid>

</UserControl>
