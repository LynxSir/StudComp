<UserControl x:Class="StudComp.Controls.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:StudComp.Behaviors"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Cards"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CardPaletteViewModel}"
             Visibility="Collapsed" Focusable="True" KeyDown="OnKeyDown"
             d:DesignHeight="500" d:DesignWidth="900">

    <Grid>
        <!-- Скрим: клик мимо панели закрывает оверлей, как в модалке настроек (12.5). -->
        <Border x:Name="Scrim" Background="#66000000" Opacity="0"
                MouseLeftButtonDown="OnScrimClick" />

        <!-- Тень — пустой подложкой позади панели (та же геометрия, трансформация и прозрачность),
             чтобы содержимое палитры не растеризовалось заново в поверхность эффекта на каждом
             кадре анимации и на каждую букву поиска (Phase 13.10, см. SettingsOverlay). -->
        <Border Width="640" VerticalAlignment="Top" Margin="0,90,0,0" CornerRadius="14"
                Height="{Binding ActualHeight, ElementName=Panel}"
                Opacity="{Binding Opacity, ElementName=Panel}"
                RenderTransform="{Binding RenderTransform, ElementName=Panel}"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.32" />
            </Border.Effect>
        </Border>

        <Border x:Name="Panel" Width="640" VerticalAlignment="Top" Margin="0,90,0,0" Opacity="0"
                CornerRadius="14" Padding="0" BorderThickness="1"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PanelScale" ScaleX="0.97" ScaleY="0.97" CenterX="320" CenterY="0" />
            </Border.RenderTransform>

            <StackPanel>
                <Grid Margin="14,12,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="18" VerticalAlignment="Center"
                                   Margin="4,0,10,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBox Grid.Column="1" x:Name="Input" BorderThickness="0" Background="Transparent"
                             FontSize="17" VerticalAlignment="Center"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="OnInputKeyDown" />
                </Grid>

                <Separator Margin="0" Background="{DynamicResource ControlElevationBorderBrush}" />

                <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         MaxHeight="380" BorderThickness="0" Background="Transparent" Margin="6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasResults, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CardPaletteRowViewModel}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock behaviors:InlineHighlightBehavior.Segments="{Binding FrontSegments}"
                                               FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SubjectName}" FontSize="10.5" Margin="10,1,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding HasSubject, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                                </StackPanel>

                                <!-- Ответ раскрывается по пробелу и остаётся здесь же: уходить со
                                     своего экрана ради одной строчки незачем. -->
                                <TextBlock behaviors:InlineHighlightBehavior.Segments="{Binding BackSegments}"
                                           FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding IsAnswerVisible, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding HintText}" Margin="18,14,18,16" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding ShowHint, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

                <Border CornerRadius="0,0,14,14" Padding="14,7"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="↑ ↓ — выбрать · Enter — открыть в разделе · Пробел — показать ответ · Esc — закрыть" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
