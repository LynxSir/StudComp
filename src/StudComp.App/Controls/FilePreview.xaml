<UserControl x:Class="StudComp.Controls.FilePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:controls="clr-namespace:StudComp.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=controls:FilePreviewViewModel}">

    <Border CornerRadius="10" Padding="16" BorderThickness="1"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Заголовок: имя файла + «тип · размер · дата» — скрыт, пока ничего не выбрано -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12"
                        Visibility="{Binding IsNone, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                <TextBlock Text="{Binding InfoLine}" FontSize="11" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <!-- Пусто: ничего не выбрано -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsNone, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <ui:SymbolIcon Symbol="DocumentSearch24" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Выберите файл слева, чтобы посмотреть" Margin="0,10,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                </StackPanel>

                <!-- Загрузка -->
                <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28"
                                 Visibility="{Binding IsLoading, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

                <!-- Изображение -->
                <Border Visibility="{Binding IsImage, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}"
                        CornerRadius="6" ClipToBounds="True">
                    <Image Source="{Binding Image}" Stretch="Uniform" />
                </Border>

                <!-- Текст/код -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsText, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding TextContent}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                </ScrollViewer>

                <!-- DOCX best-effort: первые абзацы -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsDocx, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <TextBlock Text="{Binding TextContent}" TextWrapping="Wrap" FontSize="13" />
                </ScrollViewer>

                <!-- Только «Открыть во внешнем»: PDF, архивы и прочее -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsExternalOnly, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <ui:SymbolIcon Symbol="Document24" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Предпросмотр недоступен для этого типа файла" Margin="0,10,0,10"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <ui:Button Content="Открыть во внешнем" Appearance="Secondary"
                               Icon="{ui:SymbolIcon OpenFolder24}" Command="{Binding OpenExternalCommand}" />
                </StackPanel>

                <!-- Ошибка -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsError, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding ErrorText}" Margin="0,10,0,10"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <ui:Button Content="Открыть во внешнем" Appearance="Secondary"
                               Icon="{ui:SymbolIcon OpenFolder24}" Command="{Binding OpenExternalCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

</UserControl>
