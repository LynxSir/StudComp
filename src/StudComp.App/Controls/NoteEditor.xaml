<UserControl x:Class="StudComp.Controls.NoteEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:StudComp.Behaviors"
             xmlns:controls="clr-namespace:StudComp.Controls"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             mc:Ignorable="d" AllowDrop="True" PreviewDragOver="OnImageDragOver" PreviewDrop="OnImageDrop"
             d:DataContext="{d:DesignInstance Type=controls:NoteEditorViewModel}">

    <Border CornerRadius="10" BorderThickness="1" Padding="14"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}">
        <Grid>
            <!-- Заметка не выбрана -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasNote,
                                     Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
                <ui:SymbolIcon Symbol="Notepad24" FontSize="32" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Выберите заметку или создайте новую" Margin="0,8,0,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid Visibility="{Binding HasNote,
                               Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок + переключатель предпросмотра -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0" FontSize="15" FontWeight="SemiBold"
                                PlaceholderText="Название заметки"
                                LostFocus="OnEditorLostFocus"
                                Visibility="{Binding ShowTitle, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}"
                                Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:Button Grid.Column="4" Margin="6,0,0,0" Appearance="Secondary"
                               Click="OnInsertImageClick" Content="Фото"
                               ToolTip="Вставить изображение. Можно также перетащить файл в заметку." />

                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Secondary"
                               Click="OnInsertDrawingClick"
                               ToolTip="Нарисовать"
                               Icon="{ui:SymbolIcon PaintBrush24}" />

                    <ui:Button Grid.Column="2" Margin="6,0,0,0" Appearance="Secondary"
                               Command="{Binding ShowMarkdownHelpCommand}"
                               ToolTip="Подсказка по разметке Markdown"
                               Icon="{ui:SymbolIcon QuestionCircle24}" />

                    <ui:Button Grid.Column="3" Margin="6,0,0,0" Appearance="Secondary"
                               Command="{Binding TogglePreviewCommand}"
                               ToolTip="Переключить просмотр и правку"
                               Icon="{ui:SymbolIcon Eye24}"
                               Visibility="{Binding IsPreview,
                                            Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />

                    <ui:Button Grid.Column="3" Margin="6,0,0,0" Appearance="Secondary"
                               Command="{Binding TogglePreviewCommand}"
                               ToolTip="Переключить просмотр и правку"
                               Icon="{ui:SymbolIcon Pen24}"
                               Visibility="{Binding IsPreview,
                                            Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding LinkText}" FontSize="11" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding LinkText,
                                        Converter={x:Static conv:StringPresenceToVisibilityConverter.Instance}}" />

                <!-- Ввод -->
                <ui:TextBox Grid.Row="2" x:Name="ContentTextBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                            FontFamily="Consolas, Courier New, monospace" FontSize="13"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"
                            PlaceholderText="Текст заметки в Markdown…"
                            behaviors:MarkdownEditingBehavior.IsEnabled="True"
                            LostFocus="OnEditorLostFocus"
                            PreviewKeyDown="OnContentPreviewKeyDown"
                            ContextMenuOpening="OnContentContextMenuOpening"
                            Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding IsPreview,
                                         Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
                    <ui:TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="MakeCardMenuItem" Header="Сделать карточку"
                                      Click="OnMakeCardFromSelectionClick" />
                        </ContextMenu>
                    </ui:TextBox.ContextMenu>
                </ui:TextBox>

                <!-- Предпросмотр -->
                <Border Grid.Row="2" CornerRadius="6" Padding="12" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Visibility="{Binding IsPreview,
                                     Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <!-- Клик по тексту переводит в правку (new_addons.md §11.5). -->
                    <FlowDocumentScrollViewer x:Name="PreviewViewer" Document="{Binding Preview}"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PreviewMouseLeftButtonDown="OnPreviewMouseDown"
                                              PreviewMouseLeftButtonUp="OnPreviewMouseUp" />
                </Border>

                <StackPanel Grid.Row="3" Margin="0,6,0,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button Command="{Binding OpenNoteFolderCommand}" HorizontalContentAlignment="Left"
                            ToolTip="Открыть папку копии .md. Правки заметки сохраняйте в приложении.">
                        <TextBlock Text="{Binding StorageText}" TextTrimming="CharacterEllipsis" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>

</UserControl>
