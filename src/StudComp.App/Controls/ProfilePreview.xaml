<UserControl x:Class="StudComp.Controls.ProfilePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:vm="clr-namespace:StudComp.ViewModels.ReportForge"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProfileEditorViewModel}">

    <StackPanel>
        <TextBlock Text="Предпросмотр" FontWeight="SemiBold" Margin="0,0,0,2" />
        <TextBlock Text="{Binding PreviewMarginsCaption}" FontSize="11" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- Масштабированный лист A4 -->
        <Border Width="{Binding PreviewPageWidthPx}" Height="{Binding PreviewPageHeightPx}"
                HorizontalAlignment="Left" Background="White" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.18" />
            </Border.Effect>

            <Grid>
                <!-- Номер страницы: за пределами полосы набора -->
                <TextBlock Text="8" FontFamily="{Binding FontFamily}" Foreground="#333333"
                           VerticalAlignment="Top" Margin="0,6,24,0"
                           HorizontalAlignment="{Binding PreviewPageNumberAlignment}"
                           Visibility="{Binding PreviewPageNumberTopVisible, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                <TextBlock Text="8" FontFamily="{Binding FontFamily}" Foreground="#333333"
                           VerticalAlignment="Bottom" Margin="0,0,24,6"
                           HorizontalAlignment="{Binding PreviewPageNumberAlignment}"
                           Visibility="{Binding PreviewPageNumberBottomVisible, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

                <!-- Полоса набора -->
                <StackPanel Margin="{Binding PreviewMarginPx}">
                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Opacity="0.6" Margin="0,0,0,6" />

                    <TextBlock Text="{Binding PreviewHeadingSample}"
                               FontFamily="{Binding FontFamily}"
                               FontSize="{Binding PreviewHeadingFontSize}"
                               FontWeight="{Binding PreviewHeadingWeight}"
                               TextAlignment="{Binding PreviewHeadingTextAlignment}"
                               Foreground="#111111" TextWrapping="Wrap" Margin="0,0,0,6" />

                    <TextBlock FontFamily="{Binding FontFamily}" FontSize="{Binding FontSizePt}"
                               TextAlignment="{Binding PreviewBodyTextAlignment}"
                               Foreground="#222222" TextWrapping="Wrap" Margin="0,0,0,6">
                        <InlineUIContainer BaselineAlignment="TextBottom">
                            <Border Width="{Binding PreviewBodyIndentPx}" Height="1" />
                        </InlineUIContainer><Run Text="Основной текст отчёта набирается выбранным шрифтом и кеглем с заданным межстрочным интервалом и абзацным отступом. Так будет выглядеть первый абзац раздела в готовом документе." />
                    </TextBlock>

                    <TextBlock FontFamily="{Binding FontFamily}" FontSize="{Binding FontSizePt}"
                               Foreground="#222222" TextWrapping="Wrap">
                        <Run Text="{Binding PreviewBulletMarker, Mode=OneWay}" />
                        <Run Text=" первый пункт списка" />
                    </TextBlock>
                    <TextBlock FontFamily="{Binding FontFamily}" FontSize="{Binding FontSizePt}"
                               Foreground="#222222" TextWrapping="Wrap" Margin="0,0,0,6">
                        <Run Text="{Binding PreviewBulletMarker, Mode=OneWay}" />
                        <Run Text=" второй пункт списка" />
                    </TextBlock>

                    <Border Background="{Binding PreviewCodeBackground}"
                            BorderBrush="#BFBFBF" BorderThickness="{Binding PreviewCodeBorderThickness}"
                            Padding="6,4">
                        <TextBlock FontFamily="{Binding CodeMonospaceFont}"
                                   FontSize="{Binding PreviewCodeFontSize}"
                                   Foreground="#222222" Text="var result = Report.Generate();" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>

</UserControl>
