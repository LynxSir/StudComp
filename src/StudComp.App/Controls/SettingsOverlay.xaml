<UserControl x:Class="StudComp.Controls.SettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:StudComp.Controls"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Shell"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsShellViewModel}"
             Focusable="True" KeyDown="OnKeyDown"
             Visibility="Collapsed">

    <UserControl.Resources>
        <!-- Пункт рельса разделов: винная полоса-индикатор слева у активного, мягкий hover. -->
        <Style x:Key="SettingsRailItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="10,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Grid.Column="0" Width="3" CornerRadius="2"
                                        Background="{DynamicResource ColorPrimaryBrush}" Opacity="0" />
                                <ui:SymbolIcon x:Name="Ico" Grid.Column="2" Symbol="{Binding Icon}" FontSize="18"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="Txt" Grid.Column="3" Text="{Binding Title}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="Accent" Property="Opacity" Value="1" />
                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource ColorPrimaryBrush}" />
                                <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--
            Скрим: гасит фон и перехватывает клики фоном (IsHitTestVisible не зависит от наличия
            обработчика). Закрытие по клику мимо панели убрано по прямой просьбе владельца
            (new_addons.md §10.1, Тест.txt №14) — закрывать модалку настроек должны только Esc и
            крестик в углу.
        -->
        <Border x:Name="Scrim" Background="#59000000" Opacity="0" />

        <!--
            Тень — отдельной пустой подложкой позади панели, той же геометрии, с той же
            трансформацией и прозрачностью (Phase 13.10). Раньше DropShadowEffect висел на самой
            панели: тогда каждый кадр анимации масштаба/прозрачности и каждая смена раздела внутри
            заставляли WPF заново растеризовать всё содержимое панели (сотни контролов) в
            поверхность эффекта и размывать её радиусом 40 px — это и есть «рваная» анимация на
            встроенной графике. У подложки содержимого нет, размывать нечего кроме прямоугольника.
        -->
        <Border MaxWidth="1000" MaxHeight="780" Margin="48" CornerRadius="12"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Opacity="{Binding Opacity, ElementName=Panel}"
                RenderTransformOrigin="0.5,0.5"
                RenderTransform="{Binding RenderTransform, ElementName=Panel}"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.32" />
            </Border.Effect>
        </Border>

        <Border x:Name="Panel" MaxWidth="1000" MaxHeight="780" Margin="48"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                CornerRadius="12" BorderThickness="1" Opacity="0"
                RenderTransformOrigin="0.5,0.5"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PanelScale" ScaleX="0.97" ScaleY="0.97" />
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Рельс разделов -->
                <Border Grid.Column="0" CornerRadius="12,0,0,12"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <DockPanel Margin="12,16,12,12">
                        <TextBlock DockPanel.Dock="Top" Text="Настройки" FontSize="20" FontWeight="SemiBold"
                                   Margin="6,0,6,12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="2,0,2,10"
                                    PlaceholderText="Поиск по настройкам"
                                    Icon="{ui:SymbolIcon Search24}"
                                    ClearButtonEnabled="True"
                                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock DockPanel.Dock="Bottom" Text="Ничего не найдено" Margin="8,10,8,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding NoSearchResults, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                        <ListBox ItemsSource="{Binding Sections}"
                                 SelectedItem="{Binding CurrentSection, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource SettingsRailItem}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,12,12,0" Appearance="Transparent"
                               Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CloseCommand}"
                               ToolTip="Закрыть (Esc)" />

                    <controls:FadeContentControl Grid.Row="1" Source="{Binding CurrentSection}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
