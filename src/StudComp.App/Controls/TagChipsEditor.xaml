<UserControl x:Class="StudComp.Controls.TagChipsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="320">

    <Grid>
        <!-- Поле ведёт себя как одна строка ввода: чипы и курсор живут в общей рамке, поэтому
             клик в любое место отдаёт фокус вводу. -->
        <Border x:Name="Frame" CornerRadius="6" BorderThickness="1" Padding="6,4" MinHeight="34"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                MouseLeftButtonDown="OnFrameClick">
            <WrapPanel>
                <ItemsControl x:Name="ChipsHost">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="8,2" Margin="0,2,4,2"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Button Margin="6,0,0,0" Padding="0" Width="14" Height="14"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Убрать метку"
                                            Click="OnRemoveChipClick" Tag="{Binding}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid MinWidth="90" VerticalAlignment="Center">
                    <TextBox x:Name="Input" BorderThickness="0" Background="Transparent"
                             Padding="2,0" FontSize="12"
                             TextChanged="OnInputChanged" PreviewKeyDown="OnInputKeyDown"
                             LostKeyboardFocus="OnInputLostFocus" />
                    <TextBlock x:Name="Watermark" Margin="4,0,0,0" FontSize="12"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
            </WrapPanel>
        </Border>

        <!-- Автодополнение: до восьми существующих меток, ходить по ним можно стрелками. -->
        <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=Frame}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" MinWidth="180">
            <Border CornerRadius="8" Padding="4" BorderThickness="1" Margin="0,4,0,0"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.22" />
                </Border.Effect>
                <ListBox x:Name="SuggestionsList" MaxHeight="200" BorderThickness="0"
                         Background="Transparent" PreviewKeyDown="OnSuggestionsKeyDown"
                         MouseLeftButtonUp="OnSuggestionClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" Padding="2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>

</UserControl>
