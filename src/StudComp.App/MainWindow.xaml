<ui:FluentWindow x:Class="StudComp.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:StudComp.Controls"
                 xmlns:conv="clr-namespace:StudComp.Resources.Converters"
                 xmlns:vm="clr-namespace:StudComp.ViewModels.Shell"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
                 Title="Rubrica" Width="1080" Height="720" MinWidth="900" MinHeight="600"
                 Icon="pack://application:,,,/Resources/Branding/logo-256.png"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <!-- Кнопка титул-бара (настройки, свернуть, развернуть): прозрачная, лёгкий hover. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка «Закрыть» — тот же размер, но красный hover. -->
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Чип активного предмета: мягкая скруглённая «таблетка». -->
        <Style x:Key="TitleChipButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="14" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункт иконочного сайдбара: скруглённый квадрат, винная заливка у активного. -->
        <Style x:Key="RailItem" TargetType="ListBoxItem">
            <Setter Property="ToolTip" Value="{Binding Title}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Width="46" Height="46" CornerRadius="14" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ColorPrimaryBrush}" />
                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка индикатора «Неразобранное» внизу рельса — та же геометрия. -->
        <Style x:Key="RailButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="46" Height="46" CornerRadius="14"
                                Background="{TemplateBinding Background}" HorizontalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <!-- Масштаб интерфейса (new_addons.md §7 §2): как «зум» в редакторе — влияет на всё окно. -->
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Motion.FontScale}" ScaleY="{Binding Motion.FontScale}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Полностью кастомный титул-бар (new_addons.md §1.3). Все элементы — на одной 44-px полосе,
             ровно в ряд; правый кластер: настройки → свернуть → развернуть → закрыть. -->
        <Grid Grid.Row="0" x:Name="TitleBarHost" Background="Transparent"
              MouseLeftButtonDown="TitleBarHost_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Width="28" Height="28" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Resources/Branding/logo-256.png" />
                <TextBlock Text="RUBRICA" VerticalAlignment="Center" Margin="11,1,0,0"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource ColorPrimaryBrush}" />
            </StackPanel>

            <Button Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0" Padding="12,4"
                    FontSize="12" Cursor="Hand" Style="{StaticResource TitleChipButton}"
                    Command="{Binding OpenActiveSubjectHubCommand}"
                    Content="{Binding ActiveSubjectCaption}" ToolTip="Открыть предмет"
                    Visibility="{Binding HasActiveSubject, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- «Назад» появляется только на страницах вне сайдбара (Хаб предмета). -->
                <Button Style="{StaticResource CaptionButton}" Command="{Binding GoBackCommand}"
                        ToolTip="Назад"
                        Visibility="{Binding CanGoBack, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Command="{Binding OpenSettingsCommand}"
                        ToolTip="Настройки">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="18" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip="Свернуть">
                    <ui:SymbolIcon Symbol="Subtract24" FontSize="18" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnMaxRestoreClick" ToolTip="Развернуть">
                    <ui:SymbolIcon x:Name="MaxRestoreIcon" Symbol="Maximize24" FontSize="17" />
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseClick" ToolTip="Закрыть">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Хост модальных диалогов (WPF-UI ContentDialogService) — выше оверлея настроек. -->
        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="1100" />

        <!-- Быстрый поиск по картотеке (new_addons.md §4.6): выше настроек — Ctrl+K обязан
             работать и поверх открытой модалки. -->
        <controls:CommandPalette Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="1050"
                                 DataContext="{Binding Palette}" />

        <!-- Модалка настроек (new_addons.md §1.6): выше тостов, ниже жёстких диалогов. -->
        <controls:SettingsOverlay Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="1000"
                                  DataContext="{Binding Settings}" />

        <!-- Слой всплывающих тостов: поверх контента, но под модалкой настроек. -->
        <controls:ToastHost Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="900"
                            DataContext="{Binding ToastHost}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,20,20" MaxWidth="400" />

        <DockPanel Grid.Row="1">

            <!-- Иконочный сайдбар (new_addons.md §1.4): только иконки, тултипы, разделы,
                 внизу — индикатор активности архивариуса. На время сессии рельс уезжает:
                 на экране не должно быть ничего, кроме карточки (§8.3). -->
            <DockPanel x:Name="Rail" DockPanel.Dock="Left" Width="66" Margin="4,4,4,10">
                <Button DockPanel.Dock="Bottom" Margin="0,8,0,0" Style="{StaticResource RailButton}"
                        Command="{Binding OpenUnsortedCommand}" ToolTip="Неразобранные файлы"
                        Visibility="{Binding HasUnsorted, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <Grid Width="30" Height="30">
                        <ui:SymbolIcon Symbol="FolderArrowRight24" FontSize="20" />
                        <Border Background="{DynamicResource ColorPrimaryBrush}" CornerRadius="8"
                                MinWidth="16" Height="16" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-7,0">
                            <TextBlock Text="{Binding UnsortedCount}" Foreground="White" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <ListBox x:Name="SidebarList" ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource RailItem}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationItem}">
                            <Grid Width="30" Height="30">
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>

                                <!-- Счётчик «к повторению» (new_addons.md §2.1): показывается только
                                     когда есть что повторять, и ведёт прямо на вкладку «Повторение» —
                                     счётчик обещает очередь, очередь и должна открыться. -->
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-7,0"
                                        Cursor="Hand" ToolTip="К повторению"
                                        Command="{Binding DataContext.OpenReviewQueueCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                        Visibility="{Binding HasBadge, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{DynamicResource ColorPrimaryBrush}" CornerRadius="8"
                                                    MinWidth="16" Height="16" Padding="3,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="{Binding BadgeCount}" Foreground="White" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Контент текущего раздела -->
            <Border Margin="4,4,12,12" CornerRadius="8"
                    Background="{DynamicResource ApplicationBackgroundBrush}">
                <!-- CurrentView: готовый View для разделов сайдбара (кеш, Phase 13.10 — живут в
                     дереве постоянно, переключаются Visibility) либо VM с DataTemplate. -->
                <controls:PageHost Source="{Binding Navigation.CurrentView}" />
            </Border>
        </DockPanel>
    </Grid>

</ui:FluentWindow>
