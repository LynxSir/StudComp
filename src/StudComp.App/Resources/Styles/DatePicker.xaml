<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:StudComp.Behaviors"
                    xmlns:res="clr-namespace:StudComp.Resources">

    <!--
        Единый формат даты во всех DatePicker приложения (new_addons.md §8, Тест.txt №24) — одним
        неявным стилем, без правки каждого места использования контрола. Механика — DateFormatBehavior.
    -->
    <Style TargetType="DatePicker">
        <Setter Property="behaviors:DateFormatBehavior.Format" Value="{x:Static res:AppDateFormat.ShortDate}" />
    </Style>

</ResourceDictionary>
