<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Токены отступов (new_addons.md §7 §2). Значения по умолчанию — плотность «Обычная».
        MotionService перезаписывает их для «Компактной». Потребители — Views/Settings/* и хром
        модалки настроек через {DynamicResource}. Общеприложенческая плотность — задел на будущее.
    -->

    <Thickness x:Key="Space.Page.Padding">32,24,32,24</Thickness>
    <Thickness x:Key="Space.Card.Padding">16,14,16,14</Thickness>
    <Thickness x:Key="Space.Card.Margin">0,0,0,10</Thickness>
    <Thickness x:Key="Space.Group.Margin">0,20,0,8</Thickness>

    <sys:Double x:Key="Space.Control.MinHeight">34</sys:Double>

</ResourceDictionary>
