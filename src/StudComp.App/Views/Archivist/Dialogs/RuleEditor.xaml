<UserControl x:Class="StudComp.Views.Archivist.Dialogs.RuleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:controls="clr-namespace:StudComp.Controls"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Archivist"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RuleEditorViewModel}"
             Width="560">

    <StackPanel>
        <!-- ── Что искать ─────────────────────────────────────────────────────────────────── -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Как определять файл" />
            <controls:TermHint Margin="6,0,0,0"
                                Visibility="{Binding IsRegexSelected, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}"
                                Text="Регулярное выражение — шаблон текста со спецсимволами (^ $ . *), которым можно поймать имя файла точнее, чем простым словом. Например ^ЛР\d+_.*\.docx$ найдёт «ЛР1_отчёт.docx», «ЛР23_практика.docx» и любой файл по такому образцу." />
        </StackPanel>
        <ComboBox ItemsSource="{Binding MatchTypes}" DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedMatchType, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" Margin="0,0,0,12" />

        <TextBlock Text="Условие" Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{Binding PatternHint}" Margin="0,0,0,4" />
        <TextBlock Text="{Binding PatternHint}" FontSize="11" Margin="0,0,0,2"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{Binding PatternError}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Visibility="{Binding HasPatternError, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

        <!-- ── Область действия ───────────────────────────────────────────────────────────── -->
        <TextBlock Text="Область действия" Style="{StaticResource SettingsGroupHeader}" Margin="0,0,0,4" />

        <TextBlock Text="Предмет" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Subjects}" DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" Margin="0,0,0,12" />

        <TextBlock Text="Папка" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding WatchedFolders}"
                  SelectedItem="{Binding SelectedWatchedFolder, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Ограничьте правило одной наблюдаемой папкой, если в разных папках лежат разные вещи." />

        <!-- ── Переименование при сортировке (прогрессивное раскрытие) ───────────────────────── -->
        <ui:CardExpander Style="{StaticResource AppExpander}" Header="Переименовать файл при сортировке"
                          IsExpanded="{Binding HasRenameTemplate, Mode=OneTime}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Шаблон нового имени" Margin="0,0,0,4" />
                <WrapPanel Margin="0,0,0,4">
                    <ui:Button Content="{}{Subject}" Appearance="Secondary" Padding="8,2" Margin="0,0,4,4" FontSize="11"
                               Click="OnInsertToken" Tag="{}{Subject}" ToolTip="Название предмета" />
                    <ui:Button Content="{}{Type}" Appearance="Secondary" Padding="8,2" Margin="0,0,4,4" FontSize="11"
                               Click="OnInsertToken" Tag="{}{Type}" ToolTip="Тип работы" />
                    <ui:Button Content="{}{Date}" Appearance="Secondary" Padding="8,2" Margin="0,0,4,4" FontSize="11"
                               Click="OnInsertToken" Tag="{}{Date:yyyy-MM-dd}" ToolTip="Дата обнаружения файла" />
                    <ui:Button Content="{}{OriginalName}" Appearance="Secondary" Padding="8,2" Margin="0,0,4,4" FontSize="11"
                               Click="OnInsertToken" Tag="{}{OriginalName}" ToolTip="Исходное имя без расширения" />
                    <ui:Button Content="{}{Counter}" Appearance="Secondary" Padding="8,2" Margin="0,0,4,4" FontSize="11"
                               Click="OnInsertToken" Tag="{}{Counter}" ToolTip="Порядковый номер при конфликте имён" />
                    <ui:Button Content="{}{Ext}" Appearance="Secondary" Padding="8,2" Margin="0,0,4,4" FontSize="11"
                               Click="OnInsertToken" Tag="{}{Ext}" ToolTip="Расширение с точкой" />
                </WrapPanel>
                <ui:TextBox x:Name="RenameTemplateBox" Text="{Binding RenameTemplate, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="{}{Subject}_{Type}_{Date:yyyy-MM-dd}{Ext}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Кликните по токену, чтобы вставить его в позицию курсора. Оставьте поле пустым, чтобы сохранить исходное имя." />

                <TextBlock Text="Тип работы — подставится вместо токена {Type} в шаблоне выше" Margin="0,0,0,4"
                           TextWrapping="Wrap" />
                <ui:TextBox Text="{Binding WorkType, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Например: ЛР" />
            </StackPanel>
        </ui:CardExpander>

        <!-- ── Приоритет и включение ──────────────────────────────────────────────────────── -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Приоритет" />
                    <controls:TermHint Margin="6,0,0,0"
                                        Text="Правила проверяются по убыванию приоритета — большее число проверяется раньше. Если файл подходит под два правила, победит то, что с большим приоритетом." />
                </StackPanel>
                <ui:NumberBox Value="{Binding Priority, Mode=TwoWay}" Minimum="0" Maximum="1000"
                              SpinButtonPlacementMode="Inline" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                <ui:ToggleSwitch Content="Правило включено" IsChecked="{Binding Enabled, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <ui:CardExpander Style="{StaticResource AppExpander}" Header="Предпросмотр" IsExpanded="False">
            <StackPanel>
                <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Visibility="{Binding HasShadowedPreviewItems, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}"
                           Text="Строки, отмеченные «перехватит правило выше», покажут другой результат, если поднять их приоритет." />
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" HorizontalAlignment="Left"
                                 Visibility="{Binding IsPreviewLoading, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PreviewItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RulePreviewRowViewModel}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FileName}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ProjectedName}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="перехватит правило выше" FontSize="11"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding IsShadowed, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>

</UserControl>
