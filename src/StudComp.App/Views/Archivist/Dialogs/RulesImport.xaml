<UserControl x:Class="StudComp.Views.Archivist.Dialogs.RulesImport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Archivist"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RulesImportViewModel}"
             Width="420">

    <StackPanel>
        <TextBlock Text="Как поступить с текущими правилами?" Margin="0,0,0,8" />
        <ComboBox ItemsSource="{Binding Modes}" DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedMode, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="«Заменить» удалит все нынешние правила без возможности отмены — экспортируйте их заранее, если они нужны. Предмет в файле сопоставляется по названию." />
    </StackPanel>

</UserControl>
