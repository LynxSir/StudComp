<UserControl x:Class="StudComp.Views.Archivist.RulesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:StudComp.Behaviors"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Archivist"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RulesViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                       Text="Правила проверяются сверху вниз, побеждает первое подошедшее. Перетащите правило или используйте стрелки, чтобы изменить порядок. Файл, не подошедший ни под одно правило, ждёт во вкладке «Неразобранное»." />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <ui:Button Command="{Binding ImportCommand}" Appearance="Secondary" Margin="0,0,4,0"
                           Icon="{ui:SymbolIcon ArrowImport24}" ToolTip="Импорт правил из файла" />
                <ui:Button Command="{Binding ExportCommand}" Appearance="Secondary" Margin="0,0,4,0"
                           Icon="{ui:SymbolIcon DocumentArrowRight24}" ToolTip="Экспорт правил в файл" />
                <ui:Button Command="{Binding AddCommand}" Appearance="Primary"
                           Icon="{ui:SymbolIcon Add24}" Content="Добавить правило" />
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Items}"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 HorizontalContentAlignment="Stretch"
                 behaviors:ListBoxDragReorderBehavior.Enable="True"
                 behaviors:ListBoxDragReorderBehavior.ReorderCommand="{Binding ReorderCommittedCommand}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RuleRowViewModel}">
                    <Border Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Cards.RowBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <ui:SymbolIcon Symbol="ReOrderDotsVertical24" FontSize="12" Cursor="SizeAll"
                                               HorizontalAlignment="Center" Margin="0,0,0,2" Opacity="0.5"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               ToolTip="Перетащите, чтобы изменить порядок" />
                                <ui:Button Appearance="Transparent" Padding="4,0" FontSize="10"
                                           Content="▲" ToolTip="Выше приоритетом"
                                           Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Appearance="Transparent" Padding="4,0" FontSize="10"
                                           Content="▼" ToolTip="Ниже приоритетом"
                                           Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>

                            <Border Grid.Column="1" CornerRadius="2" Background="{Binding AccentBrush}" />

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{Binding ConditionText}" FontWeight="SemiBold" FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding SubjectName, Mode=OneWay}">
                                        <Run.Style>
                                            <Style TargetType="Run">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSubjectPlaceholder}" Value="True">
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Run.Style>
                                    </Run>
                                    <Run Text="·" />
                                    <Run Text="{Binding TemplateText, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding PriorityText, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{Binding ScopeText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:ToggleSwitch Margin="0,0,12,0" VerticalAlignment="Center"
                                                 IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                 Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                 CommandParameter="{Binding}" />
                                <ui:Button Appearance="Secondary" Padding="8,4" Margin="0,0,4,0" Icon="{ui:SymbolIcon Edit24}"
                                           Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Appearance="Secondary" Padding="8,4" Icon="{ui:SymbolIcon Delete24}"
                                           Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>

</UserControl>
