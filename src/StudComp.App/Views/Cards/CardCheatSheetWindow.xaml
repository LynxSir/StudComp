<Window x:Class="StudComp.Views.Cards.CardCheatSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:behaviors="clr-namespace:StudComp.Behaviors"
        xmlns:conv="clr-namespace:StudComp.Resources.Converters"
        xmlns:vm="clr-namespace:StudComp.ViewModels.Cards"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CardCheatSheetViewModel}"
        Title="Шпаргалка — Rubrica" Icon="pack://application:,,,/Resources/Branding/logo-256.png"
        Width="360" Height="480" MinWidth="280" MinHeight="320"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip"
        Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        PreviewKeyDown="OnPreviewKeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBox Grid.Row="0" x:Name="Input" Margin="0,0,0,8"
                    Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                    PlaceholderText="Поиск по картотеке…"
                    Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />

        <ListBox Grid.Row="1" x:Name="ResultsList" ItemsSource="{Binding Results}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 Visibility="{Binding HasResults, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,7" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CardPaletteRowViewModel}">
                    <StackPanel>
                        <TextBlock behaviors:InlineHighlightBehavior.Segments="{Binding FrontSegments}"
                                   FontSize="13" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SubjectName}" FontSize="10" Margin="0,1,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasSubject, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

                        <!-- Ответ раскрывается по Space/Enter и остаётся здесь же (§8.6). -->
                        <TextBlock behaviors:InlineHighlightBehavior.Segments="{Binding BackSegments}"
                                   FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding IsAnswerVisible, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Text="{Binding HintText}" TextWrapping="Wrap" FontSize="12"
                   VerticalAlignment="Top" Margin="2,10,2,0"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Visibility="{Binding ShowHint, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

        <TextBlock Grid.Row="2" Margin="2,8,2,0" FontSize="10" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Text="↑ ↓ — выбрать · Space/Enter — ответ · Esc — закрыть" />
    </Grid>

</Window>
