<UserControl x:Class="StudComp.Views.Cards.CardExamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Cards"
             xmlns:controls="clr-namespace:StudComp.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CardExamViewModel}"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>

        <!-- Чип мультивыбора: предмет, колода или метка в билете. -->
        <DataTemplate x:Key="PickChip" DataType="{x:Type vm:ExamPickViewModel}">
            <ToggleButton IsChecked="{Binding IsChosen, Mode=TwoWay}" Margin="0,0,6,6" Cursor="Hand">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" CornerRadius="14" Padding="12,5"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,7,0"
                                        VerticalAlignment="Center" Background="{Binding Accent}"
                                        Visibility="{Binding Accent, Converter={x:Static conv:NullToCollapsedConverter.Instance}}" />
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource ColorPrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush"
                                        Value="{DynamicResource ColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="4,8,4,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- ── Конструктор билета (new_addons.md §5.6) ───────────────────────────────────────── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>

                <Border CornerRadius="10" Padding="20" Margin="0,0,0,12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Что войдёт в билет" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <TextBlock Text="Предметы" FontSize="12" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Subjects}" ItemTemplate="{StaticResource PickChip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="Колоды" FontSize="12" Margin="0,10,0,6"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Decks}" ItemTemplate="{StaticResource PickChip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="Метки" FontSize="12" Margin="0,10,0,6"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource PickChip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ui:Button Content="Сбросить выбор" Appearance="Transparent" Padding="0,6" FontSize="12"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"
                                   Command="{Binding ClearPicksCommand}" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="10" Padding="20"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Как проходить" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                <TextBlock Text="Число карточек" FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedCount}"
                                          DisplayMemberPath="Display" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="Способ проверки" FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}"
                                          DisplayMemberPath="Display" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Лимит времени" FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <ComboBox ItemsSource="{Binding TimeLimits}" SelectedItem="{Binding SelectedTimeLimit}"
                                          DisplayMemberPath="Display" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Зерно (для точного повтора)" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <controls:TermHint Margin="6,0,0,0"
                                                        Text="Зерно фиксирует случайный порядок карточек — с тем же зерном билет соберётся идентично. Оставьте пустым для нового случайного набора." />
                                </StackPanel>
                                <ui:TextBox Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="новое случайное" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Включать отложенные карточки" Margin="0,12,0,0"
                                  IsChecked="{Binding IncludeSuspended}" />
                        <CheckBox Content="Наоборот: показывать ответ, спрашивать термин" Margin="0,6,0,0"
                                  IsChecked="{Binding ReverseSides}" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <ui:Button Content="Начать экзамен" Appearance="Primary" Padding="20,10"
                                       Command="{Binding StartCommand}" />
                            <ui:Button Content="Просто потренироваться" Padding="16,10" Margin="10,0,0,0"
                                       Command="{Binding StartPracticeCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ── История экзаменов ────────────────────────────────────────────────────────────── -->
        <Border Grid.Column="1" CornerRadius="10" Padding="16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Прошлые экзамены" FontWeight="SemiBold" Margin="0,0,0,10" />

                <TextBlock Grid.Row="1" VerticalAlignment="Top" TextWrapping="Wrap" FontSize="13"
                           Text="Пока ни одного. Соберите билет слева и попробуйте себя."
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HasHistory, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />

                <ListBox Grid.Row="1" ItemsSource="{Binding History}" BorderThickness="0"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Visibility="{Binding HasHistory, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ExamHistoryRowViewModel}">
                            <Border CornerRadius="8" Padding="12"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding When}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding AccuracyText}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource ColorPrimaryBrush}" />
                                    </Grid>
                                    <TextBlock Text="{Binding ScoreText}" FontSize="13" Margin="0,4,0,0" />

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <ui:Button Content="Ещё раз" Padding="10,4" FontSize="12"
                                                   Command="{Binding DataContext.RepeatCommand,
                                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Content="Над ошибками" Padding="10,4" FontSize="12" Margin="6,0,0,0"
                                                   Command="{Binding DataContext.WorkOnMistakesCommand,
                                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding HasMisses, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
