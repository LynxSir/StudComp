<UserControl x:Class="StudComp.Views.Cards.CardLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:StudComp.Behaviors"
             xmlns:controls="clr-namespace:StudComp.Controls"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Cards"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CardLibraryViewModel}"
             d:DesignHeight="700" d:DesignWidth="1200"
             PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>
        <!-- Плитка сетки: обе стороны с подсветкой совпадений, метки, полоса цвета предмета. -->
        <DataTemplate x:Key="CardTileTemplate" DataType="{x:Type vm:CardRowViewModel}">
            <Border ToolTip="{Binding BackPreview}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding DataContext.EditCardCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Cards.TileBorder}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Цвет предмета тонкой полосой: акцент на 5–10 % площади (ARCHITECTURE §19.2). -->
                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" CornerRadius="2"
                            Background="{Binding AccentBrush}" />

                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="{Binding KindIcon}" FontSize="13" VerticalAlignment="Center"
                                       Margin="0,0,5,0" ToolTip="{Binding KindTitle}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ui:SymbolIcon Symbol="Pin24" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"
                                       Foreground="{DynamicResource ColorPrimaryBrush}"
                                       Visibility="{Binding IsPinned, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                        <TextBlock Text="{Binding SubjectName}" FontSize="10" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasSubject, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock behaviors:InlineHighlightBehavior.Segments="{Binding FrontSegments}"
                                   FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="38" />
                        <TextBlock behaviors:InlineHighlightBehavior.Segments="{Binding BackSegments}"
                                   FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxHeight="34"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse ToolTip="{Binding ReviewStateTitle}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource Cards.ReviewDot}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReviewState}" Value="Due">
                                            <Setter Property="Fill" Value="{DynamicResource ColorPrimaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ReviewState}" Value="Scheduled">
                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <ItemsControl ItemsSource="{Binding Tags}"
                                      Visibility="{Binding HasTags, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Cards.TagChip}">
                                        <TextBlock Text="{Binding}" FontSize="10"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Режим списка: та же карточка во всю ширину плюс быстрые действия по наведению. -->
        <DataTemplate x:Key="CardRowTemplate" DataType="{x:Type vm:CardRowViewModel}">
            <Border x:Name="RowBorder" Style="{StaticResource Cards.RowBorder}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding DataContext.EditCardCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="2" Background="{Binding AccentBrush}" />

                    <ui:SymbolIcon Grid.Column="2" Symbol="{Binding KindIcon}" FontSize="17"
                                   VerticalAlignment="Top" Margin="0,2,10,0" ToolTip="{Binding KindTitle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <StackPanel Grid.Column="3">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Pin24" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ColorPrimaryBrush}"
                                           Visibility="{Binding IsPinned, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                            <TextBlock behaviors:InlineHighlightBehavior.Segments="{Binding FrontSegments}"
                                       FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock behaviors:InlineHighlightBehavior.Segments="{Binding BackSegments}"
                                   FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding SubjectName}" FontSize="11" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding HasSubject, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                            <ItemsControl ItemsSource="{Binding Tags}"
                                          Visibility="{Binding HasTags, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Cards.TagChip}">
                                            <TextBlock Text="{Binding}" FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ReviewStateTitle}" FontSize="11" Margin="6,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:Button Appearance="Transparent" Padding="6" ToolTip="Закрепить (F)"
                                   Icon="{ui:SymbolIcon Pin24}"
                                   Command="{Binding DataContext.TogglePinCommand,
                                                     RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding IsDeleted, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />
                        <ui:Button Appearance="Transparent" Padding="6" ToolTip="Править (E)"
                                   Icon="{ui:SymbolIcon Edit24}"
                                   Command="{Binding DataContext.EditCardCommand,
                                                     RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding IsDeleted, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />
                        <ui:Button Appearance="Transparent" Padding="6" ToolTip="В корзину (Del)"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Command="{Binding DataContext.DeleteCardCommand,
                                                     RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding IsDeleted, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />
                        <ui:Button Appearance="Secondary" Padding="8,4" Content="Вернуть"
                                   Command="{Binding DataContext.RestoreCardCommand,
                                                     RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   CommandParameter="{Binding}"
                                   Visibility="{Binding IsDeleted, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                    <Setter TargetName="RowBorder" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}" />
                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="0" />
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="340" MinWidth="260" MaxWidth="520" />
        </Grid.ColumnDefinitions>

        <!-- ===== Левый рельс: фильтры, предметы с колодами, подборки, метки ===================== -->
        <ScrollViewer Grid.Column="0" Width="226" Margin="0,0,14,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CardFilterPreset}">
                            <Button Style="{StaticResource Cards.RailButton}"
                                    Command="{Binding DataContext.ApplyPresetCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="14" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Предметы" Style="{StaticResource Cards.RailHeader}" />

                <ItemsControl ItemsSource="{Binding SubjectNodes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CardSubjectNodeViewModel}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton Grid.Column="0" Width="18" Height="24" Padding="0"
                                                  Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  ToolTip="Показать колоды предмета"
                                                  Visibility="{Binding HasDecks, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="11">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Symbol" Value="ChevronDown24" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </ToggleButton>

                                    <Button Grid.Column="1" Style="{StaticResource Cards.RailButton}"
                                            Command="{Binding DataContext.ApplySubjectCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </Grid>
                                    </Button>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Decks}" Margin="20,0,0,0"
                                              Visibility="{Binding IsExpanded, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CardDeckNodeViewModel}">
                                            <Button Style="{StaticResource Cards.RailButton}" ToolTip="{Binding Description}"
                                                    Command="{Binding DataContext.ApplyDeckCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                    CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="12"
                                                                   Margin="0,0,6,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11"
                                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                               Visibility="{Binding ShowCount, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Умные подборки — сохранённые запросы, а не хранилища карточек (§13.8). -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Подборки" Style="{StaticResource Cards.RailHeader}" />
                    <controls:TermHint Margin="4,16,0,4"
                                        Text="Колода — набор карточек, который вы наполняете сами. Подборка — сохранённый поисковый запрос: карточки в неё попадают автоматически по условию (метка, предмет, «трудные»)." />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding SmartDecks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CardDeckNodeViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource Cards.RailButton}"
                                        ToolTip="{Binding Query}"
                                        Command="{Binding DataContext.ApplyDeckCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="12" Margin="0,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <ui:Button Grid.Column="1" Appearance="Transparent" Padding="4" ToolTip="Изменить"
                                           Icon="{ui:SymbolIcon Edit24}"
                                           Command="{Binding DataContext.EditDeckCommand,
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Grid.Column="2" Appearance="Transparent" Padding="4" ToolTip="Удалить"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           Command="{Binding DataContext.DeleteDeckCommand,
                                                             RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource Cards.RailButton}" Command="{Binding SaveSearchAsDeckCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Save24" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Сохранить поиск" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <!-- Колоды без предмета: в дереве предметов им места нет. -->
                <ItemsControl ItemsSource="{Binding LooseDecks}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CardDeckNodeViewModel}">
                            <Button Style="{StaticResource Cards.RailButton}" ToolTip="{Binding Description}"
                                    Command="{Binding DataContext.ApplyDeckCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="12" Margin="0,0,6,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource Cards.RailButton}" Command="{Binding NewDeckCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Новая колода" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <TextBlock Text="Метки" Style="{StaticResource Cards.RailHeader}" />

                <ItemsControl ItemsSource="{Binding Tags}" Margin="8,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button Appearance="Secondary" Margin="0,0,4,4" Padding="8,3" FontSize="11"
                                       ToolTip="{Binding UsageCount, StringFormat=Карточек: {0}}"
                                       Content="{Binding DisplayName}"
                                       Command="{Binding DataContext.ApplyTagCommand,
                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                       CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <CheckBox Content="Все метки" Margin="8,6,0,20" FontSize="11"
                          IsChecked="{Binding ShowAllTags, Mode=TwoWay}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Центр: поиск и выдача ========================================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Главный элемент экрана — строка поиска, всё остальное ей подчинено (§8.1). -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TextBox Grid.Column="0" x:Name="SearchBox"
                            Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Поиск: слово, «фраза», #метка, @предмет, тип:формула, трудные   ( / )"
                            Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" />

                <controls:TermHint Grid.Column="1" Margin="6,0,0,0"
                                    Text="слово — просто текст. «фраза в кавычках» — точное совпадение. #метка. @предмет. тип:формула. трудные — карточки с частыми ошибками." />

                <ComboBox Grid.Column="2" Margin="8,0,0,0" MinWidth="160" ToolTip="Порядок выдачи"
                          ItemsSource="{Binding Sorts}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />

                <ui:Button Grid.Column="3" Margin="8,0,0,0" Appearance="Secondary" Padding="10,6"
                           Command="{Binding ToggleViewCommand}" ToolTip="Сетка или список">
                    <ui:SymbolIcon FontSize="16">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="AppsList24" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                        <Setter Property="Symbol" Value="Grid24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </ui:Button>

                <!-- Импорт/экспорт (new_addons.md §7.6): меню открывается по левому клику из code-behind. -->
                <ui:Button Grid.Column="4" Margin="8,0,0,0" Appearance="Secondary" Padding="10,6"
                           Icon="{ui:SymbolIcon ArrowImport24}" ToolTip="Импорт карточек"
                           Click="OnMenuButtonClick">
                    <ui:Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="Из JSON…" Command="{Binding ImportJsonCommand}" />
                            <MenuItem Header="Из CSV/TSV…" Command="{Binding ImportCsvCommand}" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>

                <ui:Button Grid.Column="5" Margin="8,0,0,0" Appearance="Secondary" Padding="10,6"
                           Icon="{ui:SymbolIcon DocumentArrowRight24}" ToolTip="Экспорт: выделение или результат поиска"
                           Click="OnMenuButtonClick">
                    <ui:Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="В JSON…" Command="{Binding ExportJsonCommand}" />
                            <MenuItem Header="В CSV…" Command="{Binding ExportCsvCommand}" />
                        </ContextMenu>
                    </ui:Button.ContextMenu>
                </ui:Button>

                <ui:Button Grid.Column="6" Margin="8,0,0,0" Appearance="Secondary" Padding="10,6"
                           Icon="{ui:SymbolIcon Layer24}" ToolTip="Шпаргалка — компактное окно поверх остальных"
                           Command="{Binding OpenCheatSheetCommand}" />

                <ui:Button Grid.Column="7" Margin="8,0,0,0" Appearance="Primary"
                           Icon="{ui:SymbolIcon Add24}" Content="Карточка"
                           ToolTip="Новая карточка (Ctrl+N)"
                           Command="{Binding NewCardCommand}" />
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,8">
                <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:ProgressRing Width="14" Height="14" Margin="8,0,0,0" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                <ui:Button Margin="12,0,0,0" Appearance="Secondary" Padding="8,2" FontSize="11"
                           Icon="{ui:SymbolIcon Delete24}" Content="Очистить корзину"
                           Command="{Binding EmptyTrashCommand}"
                           Visibility="{Binding IsTrashView, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
            </StackPanel>

            <ui:InfoBar Grid.Row="1" Severity="Warning" IsOpen="True" Margin="0,0,0,8"
                        Title="Упрощённый поиск" Message="{Binding SearchWarning}"
                        Visibility="{Binding HasSearchWarning, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

            <!-- Панель массовых операций: появляется, когда выбрано больше одной карточки. -->
            <Border Grid.Row="2" CornerRadius="10" Padding="12,8" Margin="0,0,0,10" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ColorPrimaryBrush}"
                    Visibility="{Binding HasSelection, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                <WrapPanel>
                    <TextBlock Text="{Binding SelectionText}" FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,12,0" />

                    <ComboBox MinWidth="150" Margin="0,2,6,2" ToolTip="Перенести в предмет"
                              ItemsSource="{Binding Subjects}" DisplayMemberPath="Name"
                              SelectedItem="{Binding BulkSubject, Mode=TwoWay}" />
                    <ui:Button Appearance="Secondary" Padding="8,4" FontSize="11" Margin="0,2,12,2"
                               Content="Предмет" Command="{Binding ApplyBulkSubjectCommand}" />

                    <ComboBox MinWidth="150" Margin="0,2,6,2" ToolTip="Перенести в колоду"
                              ItemsSource="{Binding Decks}" DisplayMemberPath="Name"
                              SelectedItem="{Binding BulkDeck, Mode=TwoWay}" />
                    <ui:Button Appearance="Secondary" Padding="8,4" FontSize="11" Margin="0,2,12,2"
                               Content="Колода" Command="{Binding ApplyBulkDeckCommand}" />

                    <ui:TextBox MinWidth="130" Margin="0,2,6,2" PlaceholderText="метка"
                                Text="{Binding BulkTag, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Appearance="Secondary" Padding="8,4" FontSize="11" Margin="0,2,4,2"
                               Icon="{ui:SymbolIcon Add24}" ToolTip="Добавить метку"
                               Command="{Binding AddBulkTagCommand}" />
                    <ui:Button Appearance="Secondary" Padding="8,4" FontSize="11" Margin="0,2,12,2"
                               Icon="{ui:SymbolIcon Subtract24}" ToolTip="Снять метку"
                               Command="{Binding RemoveBulkTagCommand}" />

                    <ui:Button Appearance="Secondary" Padding="8,4" FontSize="11" Margin="0,2,4,2"
                               Icon="{ui:SymbolIcon Pin24}" Content="Закрепить"
                               Command="{Binding PinSelectedCommand}" />
                    <ui:Button Appearance="Secondary" Padding="8,4" FontSize="11" Margin="0,2,4,2"
                               Icon="{ui:SymbolIcon Pause24}" Content="Отложить"
                               Command="{Binding SuspendSelectedCommand}" />
                    <ui:Button Appearance="Secondary" Padding="8,4" FontSize="11" Margin="0,2,12,2"
                               Icon="{ui:SymbolIcon Delete24}" Content="В корзину"
                               Command="{Binding DeleteCardCommand}" />

                    <ui:Button Appearance="Transparent" Padding="8,4" FontSize="11" Margin="0,2"
                               Content="Снять выбор" Command="{Binding ClearSelectionCommand}" />
                </WrapPanel>
            </Border>

            <!-- Сетка: собственная виртуализирующая панель (new_addons.md §8.2). -->
            <ListBox Grid.Row="3" x:Name="GridList" ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     ItemTemplate="{StaticResource CardTileTemplate}"
                     ItemContainerStyle="{StaticResource Cards.ItemContainer}"
                     SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                     behaviors:ScrollEndBehavior.Command="{Binding ShowMoreCommand}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     Visibility="{Binding IsGridView, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingWrapPanel
                            ItemWidth="{StaticResource Cards.Tile.Width}"
                            ItemHeight="{StaticResource Cards.Tile.Height}" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!-- Список: штатная виртуализация, страховка на случай проблем с сеткой. -->
            <ListBox Grid.Row="3" x:Name="RowList" ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                     ItemTemplate="{StaticResource CardRowTemplate}"
                     ItemContainerStyle="{StaticResource Cards.ItemContainer}"
                     SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     behaviors:ScrollEndBehavior.Command="{Binding ShowMoreCommand}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     Visibility="{Binding IsGridView, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!-- Пустое состояние — не голый текст, а следующий шаг (new_addons.md §8.5). -->
            <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                        Visibility="{Binding ShowEmptyState, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                <ui:SymbolIcon Symbol="Layer24" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{Binding EmptyStateHint}" Margin="0,12,0,0" TextWrapping="Wrap"
                           TextAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Создать карточку"
                               Command="{Binding NewCardCommand}" />
                    <ui:Button Appearance="Secondary" Margin="8,0,0,0" Content="Сбросить фильтры"
                               Command="{Binding ClearQueryCommand}" />
                </StackPanel>
            </StackPanel>

            <ui:Button Grid.Row="4" Margin="0,8,0,0" HorizontalAlignment="Center" Appearance="Secondary"
                       Content="Показать ещё" Command="{Binding ShowMoreCommand}"
                       Visibility="{Binding CanShowMore, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
        </Grid>

        <GridSplitter Grid.Column="2" Width="6" HorizontalAlignment="Center" Background="Transparent"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

        <!-- ===== Правая панель: карточка целиком, правка на месте ============================== -->
        <Border Grid.Column="3" CornerRadius="12" Padding="16,14" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <controls:CardPreview DataContext="{Binding Preview}" />
        </Border>
    </Grid>

</UserControl>
