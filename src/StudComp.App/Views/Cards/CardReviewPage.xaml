<UserControl x:Class="StudComp.Views.Cards.CardReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Cards"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CardReviewViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,4,4">
        <StackPanel MaxWidth="880" HorizontalAlignment="Left">

            <!-- ── Сводка очереди ───────────────────────────────────────────────────────────── -->
            <Border CornerRadius="10" Padding="22" Margin="0,0,0,14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.07" Direction="270" />
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Очередь на сегодня" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding DueCount}" FontSize="34" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorPrimaryBrush}" />
                            <TextBlock Text="к повторению" FontSize="14" Margin="10,0,0,6"
                                       VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Text="{Binding NewCount}" FontSize="34" FontWeight="SemiBold" Margin="24,0,0,0" />
                            <TextBlock Text="новых" FontSize="14" Margin="10,0,0,6" VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding OverLimitText}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasOverLimit, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                    </StackPanel>

                    <ui:Button Grid.Column="1" Content="Начать повторение" Appearance="Primary"
                               Padding="22,12" FontSize="14" VerticalAlignment="Center"
                               Command="{Binding StartReviewCommand}"
                               Visibility="{Binding HasQueue, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                </Grid>
            </Border>

            <!-- ── Пустое состояние: не «нет данных», а что дальше (new_addons.md §8.5) ──────── -->
            <Border CornerRadius="10" Padding="26" Margin="0,0,0,14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasQueue, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="30" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ColorPrimaryBrush}" />
                    <TextBlock Text="На сегодня всё" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding NextDueText}" FontSize="13" Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasNextDue, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                </StackPanel>
            </Border>

            <!-- ── Обратный отсчёт к экзаменам (new_addons.md §6.4) ─────────────────────────── -->
            <StackPanel Margin="0,0,0,14"
                        Visibility="{Binding HasCountdowns, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                <TextBlock Text="Обратный отсчёт" FontWeight="SemiBold" Margin="2,0,0,8" />

                <ItemsControl ItemsSource="{Binding Countdowns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CramRowViewModel}">
                            <!-- Золотая рамка — редкий акцент значимости (ARCHITECTURE §19.2). -->
                            <Border CornerRadius="10" Padding="18" Margin="0,0,0,8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ColorAccentGoldBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="14" />
                                        <ProgressBar Height="4" Minimum="0" Maximum="100" Margin="0,8,0,0"
                                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                     Foreground="{DynamicResource ColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding ProgressText}" FontSize="12" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding Warning}" FontSize="12" Margin="0,4,0,0"
                                                   TextWrapping="Wrap" Foreground="#B26A00"
                                                   Visibility="{Binding HasWarning, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                                    </StackPanel>

                                    <ui:Button Grid.Column="1" Content="Готовиться" Padding="16,10"
                                               VerticalAlignment="Center"
                                               Command="{Binding DataContext.PrepareCommand,
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ── Разбивка по предметам ────────────────────────────────────────────────────── -->
            <StackPanel Visibility="{Binding HasQueue, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                <TextBlock Text="По предметам" FontWeight="SemiBold" Margin="2,0,0,8" />

                <ItemsControl ItemsSource="{Binding Subjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ReviewSubjectRowViewModel}">
                            <Border CornerRadius="10" Padding="0" Margin="0,0,0,8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{Binding AccentBrush}"
                                            CornerRadius="10,0,0,10" />

                                    <TextBlock Grid.Column="1" Text="{Binding SubjectName}" Margin="16,14"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="2" Text="{Binding DueCount}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <ui:Button Grid.Column="3" Content="Повторить" Margin="0,8,10,8" Padding="12,6"
                                               Command="{Binding DataContext.StartSubjectCommand,
                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
