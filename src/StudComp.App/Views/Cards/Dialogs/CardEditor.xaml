<UserControl x:Class="StudComp.Views.Cards.Dialogs.CardEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:StudComp.Behaviors"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Cards"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CardEditorViewModel}"
             Width="520">

    <StackPanel>
        <ui:InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Margin="0,0,0,10"
                    Title="Похоже на дубликат" Message="{Binding DuplicateWarning}"
                    Visibility="{Binding HasDuplicateWarning, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

        <TextBlock Text="Лицевая сторона — термин или вопрос" Margin="0,0,0,4" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ui:TextBox Text="{Binding Front, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Margin="0,12,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Оборот — определение или ответ (Markdown)" FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ui:Button Grid.Column="1" Appearance="Secondary" Padding="6,2"
                       Command="{Binding ShowMarkdownHelpCommand}"
                       ToolTip="Подсказка по разметке Markdown"
                       Icon="{ui:SymbolIcon QuestionCircle24}"
                       Visibility="{Binding CanShowMarkdownHelp,
                                    Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
        </Grid>

        <ui:TextBox Text="{Binding Back, UpdateSourceTrigger=PropertyChanged}"
                    AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxHeight="220"
                    behaviors:MarkdownEditingBehavior.IsEnabled="True"
                    VerticalScrollBarVisibility="Auto" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Предмет" Margin="0,0,0,4" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject}"
                          DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Колода" Margin="0,0,0,4" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Decks}" SelectedItem="{Binding SelectedDeck}"
                          DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                          IsEnabled="{Binding HasRealDeckChoices}" />
                <TextBlock Text="У предмета ещё нет колод" Margin="0,4,0,0" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasRealDeckChoices, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Тип" Margin="0,0,0,4" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}"
                          DisplayMemberPath="Display" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Сложность" Margin="0,0,0,4" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding Difficulties}" SelectedItem="{Binding SelectedDifficulty}"
                          DisplayMemberPath="Display" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Метки через запятую" Margin="0,12,0,4" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ui:TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="формулы, к экзамену" />

        <ui:CardExpander Header="Дополнительно" Margin="0,12,0,0" IsExpanded="False">
            <StackPanel>
                <TextBlock Text="Подсказка — показывается до ответа" Margin="0,0,0,4" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Text="{Binding Hint, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Источник" Margin="0,12,0,4" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:TextBox Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Лекция 12.09, Демидович §4.2" />

                <CheckBox Content="Закрепить — карточка идёт первой в списке и в поиске"
                          IsChecked="{Binding IsPinned}" Margin="0,12,0,0" />
                <CheckBox Content="Отложить — не участвует в тренировках, но остаётся в поиске"
                          IsChecked="{Binding IsSuspended}" Margin="0,6,0,0" />
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>

</UserControl>
