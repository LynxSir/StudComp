<UserControl x:Class="StudComp.Views.Cards.Dialogs.CardsImport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Cards"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CardsImportViewModel}"
             Width="520">

    <StackPanel>
        <TextBlock Text="Режим импорта" Margin="0,0,0,4" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ComboBox ItemsSource="{Binding Modes}" DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                  IsEnabled="{Binding IsPreviewStage, Converter={x:Static conv:InverseBooleanConverter.Instance}}"
                  HorizontalAlignment="Stretch" />

        <StackPanel Visibility="{Binding NeedsTargetDeck, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <TextBlock Text="Какую колоду заменить" Margin="0,12,0,4" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding Decks}" DisplayMemberPath="Name"
                      SelectedItem="{Binding TargetDeck, Mode=TwoWay}"
                      IsEnabled="{Binding IsPreviewStage, Converter={x:Static conv:InverseBooleanConverter.Instance}}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Существующие карточки этой колоды не удаляются — они лишь теряют привязку к ней. Импортированные получат эту колоду независимо от того, что указано в файле." />
        </StackPanel>

        <StackPanel Visibility="{Binding IsCsv, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Разделитель" FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding Delimiters}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedDelimiter, Mode=TwoWay}"
                              IsEnabled="{Binding IsPreviewStage, Converter={x:Static conv:InverseBooleanConverter.Instance}}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Кодировка" FontSize="12" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding Encodings}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedEncoding, Mode=TwoWay}"
                              IsEnabled="{Binding IsPreviewStage, Converter={x:Static conv:InverseBooleanConverter.Instance}}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>

            <CheckBox Content="Первая строка — заголовок (Front, Back, Tags, Deck)" Margin="0,10,0,0"
                      IsChecked="{Binding HasHeader, Mode=TwoWay}"
                      IsEnabled="{Binding IsPreviewStage, Converter={x:Static conv:InverseBooleanConverter.Instance}}" />

            <Border Margin="0,10,0,0" CornerRadius="6" Padding="8" MaxHeight="90"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    Visibility="{Binding HasPreviewRows, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PreviewRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas, Courier New, monospace"
                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <ui:Button Margin="0,14,0,0" Content="Показать, что получится" Appearance="Secondary"
                   HorizontalAlignment="Left"
                   Command="{Binding BuildPlanCommand}"
                   Visibility="{Binding IsPreviewStage, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />

        <StackPanel Visibility="{Binding IsPreviewStage, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <ui:InfoBar Severity="Success" IsOpen="True" IsClosable="False" Margin="0,10,0,0"
                        Title="План готов" Message="{Binding StatusText}" />
            <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding WarningsText}"
                       Visibility="{Binding WarningsText, Converter={x:Static conv:StringPresenceToVisibilityConverter.Instance}}" />
            <ui:Button Margin="0,8,0,0" Content="Назад" Appearance="Secondary" HorizontalAlignment="Left"
                       Command="{Binding BackToOptionsCommand}" />
        </StackPanel>

        <TextBlock Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Text="{Binding StatusText}"
                   Visibility="{Binding IsPreviewStage, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />
    </StackPanel>

</UserControl>
