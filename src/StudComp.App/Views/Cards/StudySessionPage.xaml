<UserControl x:Class="StudComp.Views.Cards.StudySessionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:StudComp.Controls"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Cards"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StudySessionViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000"
             Focusable="True">

    <UserControl.Resources>

        <!-- Кнопка оценки: подпись сверху, будущий интервал снизу мелким (new_addons.md §8.3). -->
        <Style x:Key="GradeButton" TargetType="Button">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource ColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вариант ответа в тесте. -->
        <Style x:Key="OptionButton" TargetType="Button" BasedOn="{StaticResource GradeButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Шапка: прогресс, счётчик, таймер, выход ───────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="20,14,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay}"
                             Background="{DynamicResource ControlFillColorSecondaryBrush}"
                             Foreground="{DynamicResource ColorPrimaryBrush}" />
            </StackPanel>

            <TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontSize="13" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0">
                <Border CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,8,0"
                        Visibility="{Binding HasTimer, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <!-- За минуту до конца полоса меняет цвет на семантический
                                     предупреждающий — не винный и не золотой (ARCHITECTURE §19.2). -->
                                <DataTrigger Binding="{Binding IsTimeWarning}" Value="True">
                                    <Setter Property="Background" Value="#FFF3CD" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding TimerText}" FontSize="13" FontFamily="Consolas" />
                </Border>

                <ui:Button Appearance="Transparent" Padding="8" ToolTip="Выйти (Esc)"
                           Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding ExitCommand}" />
            </StackPanel>
        </Grid>

        <!-- ── Загрузка ───────────────────────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" />
            <TextBlock Text="Собираем сессию…" Margin="0,12,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- ── Ход сессии ─────────────────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsRunning, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="20,20,20,0">

                <!-- Максимум 720 px: длинная строка нечитаема (new_addons.md §8.3). -->
                <controls:FlipCard MaxWidth="720" HorizontalAlignment="Center"
                                   IsFlipped="{Binding IsRevealed, Mode=OneWay}">
                  <Grid>
                    <!-- Тень — пустой подложкой под карточкой (Phase 13.10): переворот масштабирует
                         обе, но содержимое карточки (текст, формулы, варианты) больше не
                         растеризуется в поверхность эффекта на каждом кадре. -->
                    <Border CornerRadius="14" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            Width="{Binding ActualWidth, ElementName=SessionCard}"
                            Height="{Binding ActualHeight, ElementName=SessionCard}"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10" Direction="270" />
                        </Border.Effect>
                    </Border>

                    <Border x:Name="SessionCard" CornerRadius="14"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Цветная полоса предмета: акцент на 5–10 % площади (§19.2). -->
                            <Border Grid.Column="0" Background="{Binding AccentBrush}"
                                    CornerRadius="14,0,0,14" />

                            <StackPanel Grid.Column="1" Margin="24,20,24,22">

                                <!-- Шапка карточки: вид, предмет, подсказка. -->
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding KindIcon}" FontSize="15"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding SubjectName}" Margin="8,0,0,0" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="6,2"
                                               Content="Подсказка (H)" FontSize="12"
                                               Command="{Binding ShowHintCommand}"
                                               Visibility="{Binding CanShowHint, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                                </Grid>

                                <!-- Вопрос. -->
                                <TextBlock Text="{Binding QuestionText}" FontSize="22" TextWrapping="Wrap"
                                           LineHeight="30" TextAlignment="Center" Margin="0,6,0,10" />

                                <!-- Подсказка — появляется по запросу и ответа не раскрывает. -->
                                <Border CornerRadius="8" Padding="12,8" Margin="0,4,0,8"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding HintText, Converter={x:Static conv:StringPresenceToVisibilityConverter.Instance}}">
                                    <TextBlock Text="{Binding HintText}" TextWrapping="Wrap" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>

                                <!-- Пропуски. -->
                                <TextBlock Text="{Binding ClozeText}" TextWrapping="Wrap" FontSize="16"
                                           LineHeight="26" Margin="0,8,0,0"
                                           Visibility="{Binding ClozeText, Converter={x:Static conv:StringPresenceToVisibilityConverter.Instance}}" />

                                <!-- Варианты теста. -->
                                <ItemsControl ItemsSource="{Binding Options}" Margin="0,12,0,0"
                                              Visibility="{Binding IsMultipleChoice, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StudyOptionViewModel}">
                                            <Button Style="{StaticResource OptionButton}"
                                                    Command="{Binding DataContext.ChooseOptionCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCorrect}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#2E7D32" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Resources>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Ввод ответа. -->
                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding IsTypedAnswer, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                                    <ui:TextBox Text="{Binding TypedAnswer, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="Ваш ответ…" FontSize="15" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <ui:Button Content="Проверить" Appearance="Primary"
                                                   Command="{Binding SubmitTypedCommand}" />
                                        <TextBlock Text="{Binding VerdictText}" Margin="12,0,0,0" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ui:Button Content="Засчитать" Margin="0,8,0,0" HorizontalAlignment="Left"
                                               Command="{Binding AcceptAsCorrectCommand}"
                                               Visibility="{Binding CanAcceptAsCorrect, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                                </StackPanel>

                                <!-- ─ Ответ. Пока карточка не раскрыта, AnswerDocument равен null,
                                       и в дереве элементов оборота физически нет (§5.1). ─ -->
                                <StackPanel Margin="0,16,0,0"
                                            Visibility="{Binding HasAnswer, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                                    <Separator Margin="0,0,0,12"
                                               Background="{DynamicResource ControlElevationBorderBrush}" />

                                    <FlowDocumentScrollViewer Document="{Binding AnswerDocument}"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              IsToolBarVisible="False" Padding="0" />

                                    <TextBlock Text="{Binding SourceText}" FontSize="12" Margin="0,10,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding SourceText, Converter={x:Static conv:StringPresenceToVisibilityConverter.Instance}}" />

                                    <TextBlock Text="{Binding IntervalHint}" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding IntervalHint, Converter={x:Static conv:StringPresenceToVisibilityConverter.Instance}}" />
                                </StackPanel>

                                <!-- Метки. -->
                                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,14,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="7,2" Margin="0,0,6,4"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Grid>
                    </Border>
                  </Grid>
                </controls:FlipCard>
            </ScrollViewer>

            <!-- ── Низ: раскрытие или оценки ───────────────────────────────────────────────────── -->
            <Border Grid.Row="1" Padding="20,14" Background="{DynamicResource ApplicationBackgroundBrush}">
                <Grid>
                    <!-- До раскрытия — одна кнопка. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Visibility="{Binding IsRevealed, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
                        <ui:Button Content="Раскрыть следующий пропуск" MinWidth="220" Padding="16,10"
                                   Command="{Binding RevealGapCommand}"
                                   Visibility="{Binding HasHiddenGaps, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                        <ui:Button Content="Показать ответ  ·  Space" Appearance="Primary" MinWidth="240"
                                   Padding="16,10" Margin="8,0,0,0" Command="{Binding RevealCommand}" />
                    </StackPanel>

                    <!-- После раскрытия — четыре оценки с подписью будущего интервала. -->
                    <ItemsControl ItemsSource="{Binding Grades}" HorizontalAlignment="Center"
                                  Visibility="{Binding IsRevealed, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StudyGradeViewModel}">
                                <Button Style="{StaticResource GradeButton}"
                                        Command="{Binding DataContext.GradeCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Interval}" FontSize="11" Margin="0,2,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Visibility="{Binding HasInterval, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Второстепенные действия — справа, мелко. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ui:Button Appearance="Transparent" Padding="6" FontSize="12" Content="Отложить (S)"
                                   Command="{Binding SuspendCommand}" />
                        <ui:Button Appearance="Transparent" Padding="6" FontSize="12" Content="Пропустить"
                                   Command="{Binding SkipCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Итоги ──────────────────────────────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20"
                      Visibility="{Binding IsFinished, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <StackPanel MaxWidth="820" HorizontalAlignment="Center">

                <!-- Пустая сессия — честная строка вместо белого экрана. -->
                <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14"
                           Margin="0,40,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding EmptyMessage, Converter={x:Static conv:StringPresenceToVisibilityConverter.Instance}}" />

                <StackPanel Visibility="{Binding Summary, Converter={x:Static conv:NullToCollapsedConverter.Instance}}">

                    <!-- Крупно: точность и время. Золотая рамка — акцент завершённости (§19.4). -->
                    <Border CornerRadius="14" Padding="26,22" Margin="0,10,0,16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ColorAccentGoldBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Сессия завершена" FontSize="13" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <TextBlock Text="{Binding ScoreText}" FontSize="34" FontWeight="SemiBold" />
                                <TextBlock Text="·" FontSize="34" Margin="12,0"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{Binding AccuracyText}" FontSize="34" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ElapsedText}" FontSize="13" Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Разбивка по предметам и колодам. -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="10" Padding="16" Margin="0,0,8,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="По предметам" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding SubjectScores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StudyScoreRowViewModel}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" CornerRadius="10" Padding="16" Margin="8,0,0,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="По колодам" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding DeckScores}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StudyScoreRowViewModel}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Слабые места. -->
                    <Border CornerRadius="10" Padding="16" Margin="0,0,0,16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                            Visibility="{Binding WeakTags.Count, Converter={x:Static conv:NullToCollapsedConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="Слабые места" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding WeakTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StudyScoreRowViewModel}">
                                        <Border CornerRadius="6" Padding="8,3" Margin="0,0,6,4"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12" />
                                                <TextBlock Text="{Binding Text}" FontSize="11" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Список ошибок с раскрытием ответа. -->
                    <Border CornerRadius="10" Padding="16" Margin="0,0,0,16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                            Visibility="{Binding Missed.Count, Converter={x:Static conv:NullToCollapsedConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="Ошибки" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Missed}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StudyMissViewModel}">
                                        <StackPanel Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Front}" TextWrapping="Wrap" />
                                                <ui:Button Grid.Column="1" Appearance="Transparent" Padding="6,2"
                                                           FontSize="12" Content="Ответ"
                                                           Command="{Binding ToggleAnswerCommand}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Back}" TextWrapping="Wrap" FontSize="13"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding IsAnswerVisible, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Три кнопки итогов (new_addons.md §5.6). -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <ui:Button Content="Работа над ошибками" Appearance="Primary" Padding="16,10"
                                   Command="{Binding WorkOnMistakesCommand}" />
                        <ui:Button Content="Ещё раз то же самое" Padding="16,10" Margin="10,0"
                                   Command="{Binding RepeatSameCommand}" />
                        <ui:Button Content="Добавить промахи в колоду" Padding="16,10"
                                   Command="{Binding CollectMissesCommand}" />
                    </StackPanel>

                    <ui:Button Content="Готово" HorizontalAlignment="Center" Padding="24,10"
                               Command="{Binding ExitCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
