<UserControl x:Class="StudComp.Views.Organizer.DeadlinesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Organizer"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DeadlinesViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="SegmentToggle" TargetType="RadioButton">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource ColorPrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка: слева — вид и фильтры (второстепенное), справа — главное действие -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border CornerRadius="9" Padding="3" BorderThickness="1"
                        VerticalAlignment="Center" Margin="0,0,16,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentToggle}" GroupName="Grouping"
                                     Content="По сроку"
                                     IsChecked="{Binding IsGroupedBySubject,
                                                 Converter={x:Static conv:InverseBooleanConverter.Instance},
                                                 Mode=OneWay}"
                                     Command="{Binding SetGroupingCommand}"
                                     CommandParameter="{x:Static vm:DeadlineGrouping.ByWeek}" />
                        <RadioButton Style="{StaticResource SegmentToggle}" GroupName="Grouping"
                                     Content="По предмету"
                                     IsChecked="{Binding IsGroupedBySubject, Mode=OneWay}"
                                     Command="{Binding SetGroupingCommand}"
                                     CommandParameter="{x:Static vm:DeadlineGrouping.BySubject}" />
                    </StackPanel>
                </Border>

                <CheckBox Margin="0,0,16,0" VerticalAlignment="Center"
                          Content="Календарь" IsChecked="{Binding IsCalendarView, Mode=TwoWay}" />

                <CheckBox VerticalAlignment="Center"
                          Content="Показывать закрытые" IsChecked="{Binding ShowClosed, Mode=TwoWay}" />
            </StackPanel>

            <ui:Button Grid.Column="2" Command="{Binding AddCommand}" Appearance="Primary"
                       Icon="{ui:SymbolIcon Add24}" Content="Добавить дедлайн" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Календарь месяца -->
            <Border Grid.Column="0" Width="330" Margin="0,0,14,0" CornerRadius="12" Padding="14"
                    BorderThickness="1" VerticalAlignment="Top"
                    DataContext="{Binding Calendar}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Visibility="{Binding DataContext.IsCalendarView,
                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                 Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Appearance="Secondary" Padding="6,2"
                                   Icon="{ui:SymbolIcon ChevronLeft24}"
                                   Command="{Binding PreviousMonthCommand}" />
                        <ui:TextBlock Grid.Column="1" Text="{Binding MonthText}" FontTypography="BodyStrong"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="2" Appearance="Secondary" Padding="6,2" Margin="0,0,4,0"
                                   Icon="{ui:SymbolIcon ChevronRight24}"
                                   Command="{Binding NextMonthCommand}" />
                        <ui:Button Grid.Column="3" Appearance="Secondary" Padding="8,2" FontSize="11"
                                   Content="Сегодня" Command="{Binding GoTodayCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding WeekDayNames}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="10" TextAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CalendarDayViewModel}">
                                <Border x:Name="Day" Margin="1" Height="40" CornerRadius="8" Cursor="Hand"
                                        Background="Transparent" BorderThickness="1"
                                        BorderBrush="Transparent">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectDayCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="DayNumber" Text="{Binding DayText}" FontSize="12"
                                                   TextAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                    Margin="0,2,0,0">
                                            <ItemsControl ItemsSource="{Binding Markers}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CalendarMarker}">
                                                        <Ellipse Width="5" Height="5" Margin="1,0"
                                                                 Fill="{Binding Brush}"
                                                                 ToolTip="{Binding Tooltip}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding OverflowText}" FontSize="8"
                                                       VerticalAlignment="Center" Margin="2,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Visibility="{Binding HasOverflow,
                                                                    Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                        <Setter TargetName="DayNumber" Property="Foreground"
                                                Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </DataTrigger>
                                    <Trigger SourceName="Day" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Day" Property="Background"
                                                Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="Day" Property="BorderBrush"
                                                Value="{StaticResource ColorAccentGoldBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Day" Property="Background"
                                                Value="{StaticResource ColorPrimaryBrush}" />
                                        <Setter TargetName="DayNumber" Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Список, сгруппированный по сроку или предмету -->
            <Grid Grid.Column="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                            Visibility="{Binding HasItems,
                                         Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="36" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Дедлайнов нет" FontSize="15" FontWeight="SemiBold"
                               Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Ничего не горит. Добавьте срок сдачи — Rubrica напомнит заранее и сама привяжет к нему разложенный файл." />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasItems,
                                           Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeadlineGroupViewModel}">
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                        <ui:TextBlock Text="{Binding Title}" FontTypography="BodyStrong" />
                                        <Border CornerRadius="999" Padding="7,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding Count}" FontSize="10" />
                                        </Border>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Items}"
                                                  ItemTemplate="{StaticResource DeadlineCard}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
