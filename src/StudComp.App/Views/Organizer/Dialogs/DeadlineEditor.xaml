<UserControl x:Class="StudComp.Views.Organizer.Dialogs.DeadlineEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Organizer"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DeadlineEditorViewModel}"
             Width="440">

    <StackPanel>
        <TextBlock Text="Название" Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="Предмет" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Subjects}" DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" Margin="0,0,0,12" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Дата сдачи" Margin="0,0,0,4" />
                <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Время (ЧЧ:ММ)" Margin="0,0,0,4" />
                <ui:TextBox Width="90" Text="{Binding DueTimeText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Тип" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Types}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedType, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Приоритет" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Priorities}" DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedPriority, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </StackPanel>

</UserControl>
