<UserControl x:Class="StudComp.Views.Organizer.Dialogs.SubjectEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Organizer"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SubjectEditorViewModel}"
             Width="420">

    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,0">
        <TextBlock Text="Название" Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="Код / аббревиатура" Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="Преподаватель по умолчанию" Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding TeacherFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
        <TextBlock Text="Подставляется в форму пары и блокируется там — можно указать другого именно на одной паре."
                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="Форма контроля (в зачётке)" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Assessments}" DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedAssessment, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" Margin="0,0,0,12" />

        <TextBlock Text="Семестр" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Semesters}" DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedSemester, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" Margin="0,0,0,12" />

        <TextBlock Text="Папка предмета" Margin="0,0,0,4" />

        <!-- Обычный случай: достаточно названия, путь считается от учебной папки (new_addons.md §4). -->
        <Grid Visibility="{Binding UsesCustomPath, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Название папки" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Secondary" VerticalAlignment="Stretch"
                       ToolTip="Выбрать произвольную папку вне учебной"
                       Icon="{ui:SymbolIcon FolderOpen24}"
                       Command="{Binding PickCustomFolderCommand}" />
        </Grid>

        <!-- Своя папка: путь вне учебной, работает как раньше и молча никуда не переезжает. -->
        <Border Visibility="{Binding UsesCustomPath, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}"
                Padding="10,8" CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="FolderLink24" FontSize="14" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Своя папка" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding CustomFolderPath}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Content="Вернуть в учебную папку" Appearance="Secondary" FontSize="11"
                               Command="{Binding UseStudyFolderCommand}" />
                    <ui:Button Content="Другая папка" Appearance="Transparent" FontSize="11" Margin="8,0,0,0"
                               Command="{Binding PickCustomFolderCommand}" />
                </StackPanel>
                <TextBlock Text="Файлы на диске не переносятся — меняется только то, где программа их ищет."
                           TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding FolderPreviewText}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="Цвет (#RRGGBB)" Margin="0,0,0,4" />
        <ui:TextBox Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

        <TextBlock Text="Профиль оформления отчётов" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding ReportTemplates}" DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedReportTemplate, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" Margin="0,0,0,12" />

        <TextBlock Text="Стратегия прогноза оценки" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding ForecastStrategies}" DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedForecastStrategy, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" />
        <TextBlock Text="Линейная регрессия точнее для предметов с 5+ оценками и заметным трендом."
                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="Система оценивания" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding GradeScales}" DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedGradeScale, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" />

        <Grid Margin="0,12,0,0"
              Visibility="{Binding IsCustomScale, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Максимальный балл" Margin="0,0,0,4" />
                <ui:TextBox Text="{Binding CustomMaxText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Порог сдачи" Margin="0,0,0,4" />
                <ui:TextBox Text="{Binding CustomPassText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>
    </StackPanel>
    </ScrollViewer>

</UserControl>
