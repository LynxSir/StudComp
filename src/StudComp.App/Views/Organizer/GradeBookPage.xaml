<UserControl x:Class="StudComp.Views.Organizer.GradeBookPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Organizer"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:controls="clr-namespace:StudComp.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GradeBookViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Выбор предмета + добавление оценки -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- В Хабе предмета зачётка открыта на одном предмете — пикер там прячется. -->
            <ComboBox Grid.Column="0" ItemsSource="{Binding Subjects}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Visibility="{Binding IsSubjectPickerVisible,
                                   Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

            <ui:Button Grid.Column="2" Command="{Binding AddCommand}" Appearance="Primary"
                       Icon="{ui:SymbolIcon Add24}" Content="Добавить оценку"
                       IsEnabled="{Binding HasSubjects}" />
        </Grid>

        <ui:InfoBar Grid.Row="1" Margin="0,0,0,12" Severity="Informational" IsClosable="False"
                    IsOpen="{Binding HasSubjects, Converter={x:Static conv:InverseBooleanConverter.Instance}}"
                    Title="Нет предметов"
                    Message="Добавьте предмет на вкладке «Предметы» — зачётка и прогноз строятся по предмету." />

        <!-- Карточка прогноза -->
        <Border Grid.Row="2" Margin="0,0,0,12" CornerRadius="8" Padding="16,14" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding HasForecast, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <StackPanel>
                <TextBlock Text="Прогноз итоговой оценки" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding PredictedScoreText}" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="{Binding ScaleHintText}" FontSize="14" Margin="8,0,0,6"
                               VerticalAlignment="Bottom"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock Margin="0,2,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Run Text="Уверенность:" />
                    <Run Text="{Binding ConfidenceText}" />
                    <Run Text="  ·  " />
                    <Run Text="{Binding PassVerdictText}" />
                </TextBlock>

                <TextBlock Text="{Binding StrategyComparisonText}" Margin="0,8,0,0" FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding StrategyComparisonText, Converter={x:Static conv:StringPresenceToVisibilityConverter.Instance}}" />

                <ui:CardExpander Style="{StaticResource AppExpander}" Header="Поставить целевую оценку"
                                 IsExpanded="{Binding HasTargetGrade, Mode=OneWay}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Целевая оценка" Margin="0,0,0,4" FontSize="12" />
                                <ui:TextBox Width="120"
                                            Text="{Binding TargetGradeText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="напр. 4,5" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <TextBlock Text="Нужно набрать на ближайшей аттестации" Margin="0,0,0,4" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding RequiredScoreText}" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <ui:InfoBar Margin="0,12,0,0" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding ShowWarning}"
                                    Title="Цель уже недостижима"
                                    Message="Даже максимальный балл на всех оставшихся аттестациях не выводит на эту оценку." />
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>
        </Border>

        <!-- Карточка графика тренда оценок — аналитика, не основной путь, свёрнута по умолчанию -->
        <ui:CardExpander Grid.Row="3" Style="{StaticResource AppExpander}" Header="Тренд оценок"
                         IsExpanded="False" Margin="0,0,0,12"
                         Visibility="{Binding ShowTrendChart, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <StackPanel>
                <controls:GradeTrendChart Data="{Binding TrendData}" Height="180" HorizontalAlignment="Stretch" />
                <TextBlock Margin="0,6,0,0" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="● сдано · ○ план · сплошная — тренд (регрессия) · – – средневзвешенная" />
            </StackPanel>
        </ui:CardExpander>

        <!-- Список оценок -->
        <Grid Grid.Row="4">
            <ui:InfoBar Severity="Informational" IsClosable="False" VerticalAlignment="Top"
                        Title="Оценок пока нет"
                        Message="Добавьте оценки и запланированные аттестации — прогноз пересчитается сам.">
                <ui:InfoBar.Style>
                    <Style TargetType="ui:InfoBar">
                        <Setter Property="IsOpen" Value="False" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasSubjects}" Value="True" />
                                    <Condition Binding="{Binding Items.Count}" Value="0" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsOpen" Value="True" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:InfoBar.Style>
            </ui:InfoBar>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GradeRowViewModel}">
                            <Border x:Name="RowBorder" Style="{StaticResource Cards.RowBorder}" Cursor="Arrow">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="2" Background="{Binding AccentBrush}" />

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12">
                                            <Run Text="{Binding TypeText}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding WeightText}" />
                                            <Run Text="·" />
                                            <Run Text="{Binding DateText}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0"
                                                HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ScoreText}" FontWeight="SemiBold" FontSize="13"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding PercentText}" FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Appearance="Secondary" Padding="8,4" Margin="0,0,4,0" Icon="{ui:SymbolIcon Edit24}"
                                                   Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowBorder}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button Appearance="Secondary" Padding="8,4" Icon="{ui:SymbolIcon Delete24}"
                                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Opacity" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowBorder}" Value="True">
                                                            <Setter Property="Opacity" Value="1" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>

</UserControl>
