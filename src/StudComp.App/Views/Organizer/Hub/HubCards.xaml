<UserControl x:Class="StudComp.Views.Organizer.Hub.HubCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:behaviors="clr-namespace:StudComp.Behaviors"
             xmlns:controls="clr-namespace:StudComp.Controls"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:vmCards="clr-namespace:StudComp.ViewModels.Cards"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Organizer.Hub"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HubCardsViewModel}"
             d:DesignHeight="500" d:DesignWidth="900">

    <Grid Margin="0,12,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Поиск внутри предмета: фильтрует уже загруженные карточки, без похода в базу. -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Поиск по карточкам предмета: слово, #метка, тип:формула"
                        Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" />

            <!-- Тренажёр появился в 12.8 — до него этой кнопке было некуда вести. -->
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Secondary"
                       Icon="{ui:SymbolIcon Play24}" Content="Тренировать предмет"
                       ToolTip="Прогнать все карточки этого предмета"
                       Command="{Binding TrainCommand}" />
            <ui:Button Grid.Column="2" Margin="8,0,0,0" Appearance="Secondary"
                       Icon="{ui:SymbolIcon Layer24}" Content="В Картотеку"
                       ToolTip="Открыть раздел с фильтром по этому предмету"
                       Command="{Binding OpenLibraryCommand}" />
            <ui:Button Grid.Column="3" Margin="8,0,0,0" Appearance="Primary"
                       Icon="{ui:SymbolIcon Add24}" Content="Карточка"
                       Command="{Binding NewCardCommand}" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,10">
            <TextBlock Text="{Binding SummaryText}" FontSize="12.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:ProgressRing Width="14" Height="14" Margin="8,0,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
        </StackPanel>

        <!-- Колоды предмета: клик уводит в раздел с готовым фильтром по колоде. -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Decks}" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vmCards:CardDeckNodeViewModel}">
                    <ui:Button Appearance="Secondary" Margin="0,0,6,6" Padding="10,4" FontSize="12"
                               ToolTip="{Binding Description}"
                               Command="{Binding DataContext.OpenDeckCommand,
                                                 RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="12" Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Count}" Margin="6,0,0,0" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding ShowCount, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                        </StackPanel>
                    </ui:Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Сетка карточек — та же виртуализирующая панель, что в библиотеке. -->
        <ListBox Grid.Row="3" ItemsSource="{Binding Items}"
                 ItemContainerStyle="{StaticResource Cards.ItemContainer}"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 Visibility="{Binding HasItems, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:VirtualizingWrapPanel
                        ItemWidth="{StaticResource Cards.Tile.Width}"
                        ItemHeight="{StaticResource Cards.Tile.Height}" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vmCards:CardRowViewModel}">
                    <Border ToolTip="{Binding BackPreview}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding DataContext.OpenCardCommand,
                                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          CommandParameter="{Binding}" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource Cards.TileBorder}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" CornerRadius="2"
                                    Background="{Binding AccentBrush}" />

                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="{Binding KindIcon}" FontSize="13" Margin="0,0,5,0"
                                               VerticalAlignment="Center" ToolTip="{Binding KindTitle}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <ui:SymbolIcon Symbol="Pin24" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ColorPrimaryBrush}"
                                               Visibility="{Binding IsPinned, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock behaviors:InlineHighlightBehavior.Segments="{Binding FrontSegments}"
                                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="38" />
                                <TextBlock behaviors:InlineHighlightBehavior.Segments="{Binding BackSegments}"
                                           FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="34"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ReviewStateTitle}"
                                       FontSize="10.5" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Пустое состояние — следующий шаг, а не констатация пустоты (new_addons.md §8.5). -->
        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400"
                    Visibility="{Binding HasItems, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
            <ui:SymbolIcon Symbol="Layer24" FontSize="36" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="По этому предмету карточек пока нет. Заведите первую — термин, формулу или вопрос к экзамену."
                       Visibility="{Binding HasAnyCards, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />

            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Ни одна карточка предмета не подошла под фильтр."
                       Visibility="{Binding HasAnyCards, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

            <ui:Button Margin="0,14,0,0" HorizontalAlignment="Center" Appearance="Primary"
                       Icon="{ui:SymbolIcon Add24}" Content="Создать карточку"
                       Command="{Binding NewCardCommand}" />
        </StackPanel>
    </Grid>

</UserControl>
