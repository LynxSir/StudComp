<UserControl x:Class="StudComp.Views.Organizer.Hub.HubDeadlines"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Organizer"
             xmlns:vmHub="clr-namespace:StudComp.ViewModels.Organizer.Hub"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vmHub:HubDeadlinesViewModel}"
             d:DesignHeight="500" d:DesignWidth="900">

    <!-- Карточка дедлайна — общий шаблон DeadlineCard из Resources/Styles/DeadlineCard.xaml -->

    <Grid Margin="0,12,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка: закрытые дедлайны, добавление -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"
                      Content="Показывать закрытые" IsChecked="{Binding ShowClosed, Mode=TwoWay}" />

            <ui:Button Grid.Column="2" Command="{Binding AddCommand}" Appearance="Primary"
                       Icon="{ui:SymbolIcon Add24}" Content="Добавить дедлайн" />
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380"
                        Visibility="{Binding HasItems,
                                     Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="36" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="У этого предмета пока нет дедлайнов" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Ничего не горит. Добавьте срок сдачи — Rubrica напомнит заранее." />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasItems,
                                       Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource DeadlineCard}" />
            </ScrollViewer>
        </Grid>
    </Grid>

</UserControl>
