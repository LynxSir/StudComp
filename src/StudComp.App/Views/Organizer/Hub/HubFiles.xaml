<UserControl x:Class="StudComp.Views.Organizer.Hub.HubFiles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:StudComp.Controls"
             xmlns:behaviors="clr-namespace:StudComp.Behaviors"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Organizer.Hub"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HubFilesViewModel}">

    <Grid Margin="0,12,4,0">

        <!-- Папки предмета ещё нет -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                    Visibility="{Binding HasFolder,
                                 Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
            <ui:SymbolIcon Symbol="FolderAdd24" FontSize="36" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="{Binding FolderPathText}" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,10,0,0" FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:Button HorizontalAlignment="Center" Margin="0,12,0,0" Appearance="Primary"
                       Icon="{ui:SymbolIcon FolderAdd24}" Content="Создать папку предмета"
                       Command="{Binding CreateFolderCommand}" />
        </StackPanel>

        <!-- Браузер файлов: дерево + список + предпросмотр, зона приёма перетаскивания -->
        <Grid behaviors:FileDropBehavior.DropCommand="{Binding DropCommand}"
              behaviors:FileDropBehavior.IsDragOver="{Binding IsDragOver, Mode=TwoWay}"
              Background="Transparent"
              Visibility="{Binding HasFolder,
                           Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Margin="0,0,0,8" FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="{Binding FolderPathText, Mode=OneWay}" />
                <Run Text="  " />
                <Run Text="{Binding ImportStatusText, Mode=OneWay}"
                     Foreground="{StaticResource ColorPrimaryBrush}" />
            </TextBlock>

            <!-- Дерево подпапок с ленивой подгрузкой -->
            <TreeView Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Tree}"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:FileNodeViewModel}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- Список файлов текущей папки -->
            <Grid Grid.Row="1" Grid.Column="2">
                <TextBlock VerticalAlignment="Top" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="В этой папке пока пусто. Перетащите сюда файлы из проводника — Rubrica спросит, перенести их или скопировать."
                           Visibility="{Binding HasFiles,
                                        Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />

                <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         Visibility="{Binding HasFiles,
                                      Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="8" Padding="12,8" BorderThickness="1"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{StaticResource ColorPrimaryBrush}" />
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SubjectFileRowViewModel}">
                            <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.OpenFileCommand,
                                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}" />
                                </Grid.InputBindings>

                                <!--
                                    PlacementTarget.DataContext давал бы DataContext строки файла
                                    (SubjectFileRowViewModel — команд там нет), а не Хаба. Команды живут
                                    на HubFilesViewModel, поэтому идём через Tag (Phase 13.11).
                                -->
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Открыть"
                                                  Command="{Binding PlacementTarget.Tag.OpenFileCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Показать в проводнике"
                                                  Command="{Binding PlacementTarget.Tag.RevealFileCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Заметка к файлу"
                                                  Command="{Binding PlacementTarget.Tag.AddNoteForFileCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Создать карточку"
                                                  Command="{Binding PlacementTarget.Tag.CreateCardForFileCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <ui:SymbolIcon Grid.Column="0" FontSize="18" VerticalAlignment="Center"
                                               Symbol="{Binding Extension,
                                                        Converter={x:Static conv:FileExtensionToSymbolConverter.Instance}}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding InfoText}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <controls:FilePreview Grid.Row="1" Grid.Column="4" DataContext="{Binding Preview}" />

            <!-- Оверлей перетаскивания поверх всей зоны -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="5"
                    CornerRadius="10" BorderThickness="2" IsHitTestVisible="False"
                    Background="#22000000"
                    BorderBrush="{StaticResource ColorPrimaryBrush}"
                    Visibility="{Binding IsDragOver,
                                 Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="36" HorizontalAlignment="Center"
                                   Foreground="{StaticResource ColorPrimaryBrush}" />
                    <TextBlock Text="{Binding DropHintText}" FontSize="16" FontWeight="SemiBold"
                               Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Ctrl — скопировать, Shift — перенести" FontSize="12"
                               Margin="0,4,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</UserControl>
