<UserControl x:Class="StudComp.Views.Organizer.Hub.HubNotes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:StudComp.Controls"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Organizer.Hub"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HubNotesViewModel}">

    <Grid Margin="0,12,4,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Список заметок -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:Button Grid.Row="0" Margin="0,0,0,10" HorizontalAlignment="Stretch" Appearance="Primary"
                       Icon="{ui:SymbolIcon Add24}" Content="Новая заметка"
                       Command="{Binding AddCommand}" />

            <TextBlock Grid.Row="1" VerticalAlignment="Top" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Заметок по предмету пока нет. Конспект лекции, пометка к файлу или просто мысль — всё сюда."
                       Visibility="{Binding HasItems,
                                    Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />

            <ListBox Grid.Row="1" ItemsSource="{Binding Items}"
                     SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     Visibility="{Binding HasItems,
                                  Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="8" Padding="12,9" BorderThickness="1"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush"
                                                    Value="{StaticResource ColorPrimaryBrush}" />
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NoteRowViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Pin24" FontSize="12" Margin="0,0,4,0"
                                                   Foreground="{StaticResource ColorAccentGoldBrush}"
                                                   Visibility="{Binding IsPinned,
                                                                Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding Excerpt}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <Run Text="{Binding KindText, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding UpdatedText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <ui:Button Appearance="Secondary" Padding="6,2" Margin="0,0,4,0"
                                           Icon="{ui:SymbolIcon Pin24}" ToolTip="Закрепить"
                                           Command="{Binding DataContext.TogglePinCommand,
                                                     RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Appearance="Secondary" Padding="6,2"
                                           Icon="{ui:SymbolIcon Delete24}" ToolTip="Удалить"
                                           Command="{Binding DataContext.DeleteCommand,
                                                     RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Разбор на карточки (new_addons.md §7.3) — предпросмотр, ничего не создаётся молча. -->
            <ui:Button Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,0,8" Appearance="Secondary"
                       Icon="{ui:SymbolIcon Layer24}" Content="Разобрать на карточки"
                       Command="{Binding ParseIntoCardsCommand}"
                       Visibility="{Binding Editor.HasNote,
                                    Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

            <controls:NoteEditor Grid.Row="1" DataContext="{Binding Editor}" />
        </Grid>
    </Grid>

</UserControl>
