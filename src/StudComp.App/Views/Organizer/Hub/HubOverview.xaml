<UserControl x:Class="StudComp.Views.Organizer.Hub.HubOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Organizer.Hub"
             xmlns:vmOrganizer="clr-namespace:StudComp.ViewModels.Organizer"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HubOverviewViewModel}">

    <UserControl.Resources>
        <Style x:Key="ZoneCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,4,0">
        <StackPanel>

            <!-- Часы за семестр -->
            <Border Style="{StaticResource ZoneCard}">
                <StackPanel>
                    <ui:TextBlock Text="Часы за семестр" FontTypography="BodyStrong" Margin="0,0,0,10" />

                    <!-- Семестр не настроен или у него нет даты окончания — честно говорим об этом -->
                    <StackPanel Visibility="{Binding HasHours,
                                Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding HoursUnavailableText}" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:Button Margin="0,10,0,0" HorizontalAlignment="Left" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon CalendarLtr24}" Content="Настроить семестр"
                                   Command="{Binding OpenSemesterSettingsCommand}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasHours,
                                Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                        <ui:TextBlock Text="{Binding TotalHoursText}" FontTypography="Subtitle" />
                        <TextBlock Text="{Binding ProgressText}" FontSize="12" Margin="0,2,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <ProgressBar Height="6" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"
                                     Foreground="{StaticResource ColorPrimaryBrush}" Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding Hours}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HubHoursRow}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TypeText}" FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding HoursText}" FontSize="13"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding HeldText}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding NextClassText}" FontSize="12" Margin="0,10,0,0"
                                   Foreground="{StaticResource ColorPrimaryBrush}"
                                   Visibility="{Binding HasNextClass,
                                                Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Дедлайны предмета -->
            <Border Style="{StaticResource ZoneCard}">
                <StackPanel>
                    <ui:TextBlock Text="Ближайшие дедлайны" FontTypography="BodyStrong" Margin="0,0,0,10" />

                    <TextBlock Text="Открытых дедлайнов по предмету нет." FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasDeadlines,
                                            Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />

                    <ItemsControl ItemsSource="{Binding Deadlines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vmOrganizer:DeadlineRowViewModel}">
                                <Border Margin="0,0,0,6" CornerRadius="8" Padding="12,8" BorderThickness="1"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource ColorAccentGoldBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#C0392B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding DueText}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
