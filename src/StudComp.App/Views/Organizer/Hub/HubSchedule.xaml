<UserControl x:Class="StudComp.Views.Organizer.Hub.HubSchedule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Organizer.Hub"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HubScheduleViewModel}">

    <Grid Margin="0,12,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:Button Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,0,12"
                   Command="{Binding AddCommand}" Appearance="Primary"
                   Icon="{ui:SymbolIcon Add24}" Content="Добавить пару" />

        <TextBlock Grid.Row="1" VerticalAlignment="Top" FontSize="13"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="У предмета пока нет пар в расписании."
                   Visibility="{Binding HasItems,
                                Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}"
                      Visibility="{Binding HasItems,
                                   Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:HubScheduleRowViewModel}">
                    <Border Margin="0,0,0,8" CornerRadius="10" Padding="14,10" BorderThickness="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <!-- Пара, с которой пришли в Хаб (new_addons.md §5) -->
                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource ColorPrimaryBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DayText}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{Binding ParityText}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="13"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding TypeText}" FontSize="13" />
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Room, Mode=OneWay}" />
                                    <Run Text=" " />
                                    <Run Text="{Binding Teacher, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Appearance="Secondary" Padding="8,4" Margin="0,0,4,0"
                                           Icon="{ui:SymbolIcon Edit24}"
                                           Command="{Binding DataContext.EditCommand,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                                <ui:Button Appearance="Secondary" Padding="8,4"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           Command="{Binding DataContext.DeleteCommand,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>

</UserControl>
