<UserControl x:Class="StudComp.Views.Organizer.SubjectHubPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Organizer"
             xmlns:hub="clr-namespace:StudComp.Views.Organizer.Hub"
             xmlns:local="clr-namespace:StudComp.Views.Organizer"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SubjectHubViewModel}">

    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка Хаба: цвет предмета, название, семестр/преподаватели/аудитории, действия -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0" Appearance="Secondary" Padding="8,4" Margin="0,0,12,0"
                       VerticalAlignment="Center" ToolTip="Назад"
                       Icon="{ui:SymbolIcon ArrowLeft24}"
                       Command="{Binding GoBackCommand}" />

            <Border Grid.Column="1" Width="6" CornerRadius="3" Background="{Binding AccentBrush}" />

            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock Text="{Binding SubjectName}" FontTypography="Title" />
                    <Border CornerRadius="999" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding SubjectCode}" FontSize="11" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Secondary" Margin="0,0,6,0"
                           Icon="{ui:SymbolIcon FolderOpen24}" Content="Папка предмета"
                           Command="{Binding OpenFolderCommand}" />
                <ui:Button Appearance="Secondary" Margin="0,0,6,0"
                           Icon="{ui:SymbolIcon DocumentText24}" Content="Сгенерировать отчёт"
                           Command="{Binding GenerateReportCommand}" />
                <ui:Button Appearance="Secondary"
                           Icon="{ui:SymbolIcon Edit24}" Content="Изменить"
                           Command="{Binding EditSubjectCommand}" />
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="Обзор">
                <hub:HubOverview DataContext="{Binding Overview}" />
            </TabItem>
            <TabItem Header="Файлы">
                <hub:HubFiles DataContext="{Binding Files}" />
            </TabItem>
            <TabItem Header="Расписание">
                <hub:HubSchedule DataContext="{Binding Schedule}" />
            </TabItem>
            <TabItem Header="Заметки">
                <hub:HubNotes DataContext="{Binding Notes}" />
            </TabItem>
            <TabItem Header="Оценки">
                <local:GradeBookPage DataContext="{Binding Grades}" />
            </TabItem>
            <TabItem Header="Карточки">
                <hub:HubCards DataContext="{Binding Cards}" />
            </TabItem>
            <TabItem Header="Дедлайны">
                <hub:HubDeadlines DataContext="{Binding Deadlines}" />
            </TabItem>
        </TabControl>
    </Grid>

</UserControl>
