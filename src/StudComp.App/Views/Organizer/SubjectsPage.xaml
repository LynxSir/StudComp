<UserControl x:Class="StudComp.Views.Organizer.SubjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Organizer"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SubjectsViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBlock Grid.Column="0" Text="{Binding SemesterText}" FontTypography="BodyStrong"
                          VerticalAlignment="Center" />

            <ui:Button Grid.Column="1" Command="{Binding AddCommand}" Appearance="Primary"
                       Icon="{ui:SymbolIcon Add24}" Content="Добавить предмет" />
        </Grid>

        <!-- Дружелюбное пустое состояние -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400"
                    Visibility="{Binding HasItems,
                                 Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}">
            <ui:SymbolIcon Symbol="BookOpen24" FontSize="36" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Предметов пока нет" FontSize="15" FontWeight="SemiBold"
                       Margin="0,10,0,0" HorizontalAlignment="Center" />
            <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Добавьте первый предмет — у него сразу появится папка в учебной папке, а расписание, дедлайны и оценки привяжутся к нему." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasItems,
                                   Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SubjectCardViewModel}">
                        <Border x:Name="Card" Width="288" Height="184" Margin="0,0,12,12"
                                CornerRadius="12" BorderThickness="1" Cursor="Hand"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.10" />
                            </Border.Effect>

                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.OpenHubCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>

                            <!--
                                PlacementTarget.DataContext давал бы DataContext самой карточки
                                (SubjectCardViewModel — команд там нет), а не страницы. Команды живут на
                                SubjectsViewModel, поэтому идём через Tag (Phase 13.11).
                            -->
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Открыть хаб"
                                              Command="{Binding PlacementTarget.Tag.OpenHubCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Изменить"
                                              Command="{Binding PlacementTarget.Tag.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Удалить"
                                              Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Шапка карточки в разбавленном цвете предмета -->
                                <Border Grid.Row="0" CornerRadius="11,11,0,0" Padding="14,10"
                                        Background="{Binding FillBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="2"
                                                Background="{Binding AccentBrush}" />

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       FontSize="15" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Code}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- Прогноз итога — редкий золотой акцент -->
                                        <Border Grid.Column="3" CornerRadius="999" Padding="10,3"
                                                VerticalAlignment="Top" BorderThickness="1"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{StaticResource ColorAccentGoldBrush}"
                                                Visibility="{Binding HasForecast,
                                                             Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                                            <TextBlock Text="{Binding ForecastText}" FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Ближайшая пара и часы -->
                                <StackPanel Grid.Row="1" Margin="14,10,14,0">
                                    <TextBlock Text="{Binding AssessmentText}" FontSize="12" Margin="0,0,0,6"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Clock24" FontSize="13" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding NextClassText}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                                Visibility="{Binding HasHours,
                                                             Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                                        <ui:SymbolIcon Symbol="Timer24" FontSize="13" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding HoursText}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Дедлайны -->
                                <Border Grid.Row="2" Margin="14,0,14,12" CornerRadius="999" Padding="10,3"
                                        HorizontalAlignment="Left" BorderThickness="1"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding HasDeadlines,
                                                     Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOverdue}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#C0392B" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DeadlinesText}" FontSize="11" />
                                </Border>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{StaticResource ColorPrimaryBrush}" />
                                <Setter TargetName="Card" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</UserControl>
