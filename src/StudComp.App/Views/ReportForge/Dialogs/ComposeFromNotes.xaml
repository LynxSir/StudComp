<UserControl x:Class="StudComp.Views.ReportForge.Dialogs.ComposeFromNotes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:vm="clr-namespace:StudComp.ViewModels.ReportForge"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ComposeFromNotesViewModel}"
             Width="480">

    <StackPanel>
        <TextBlock Text="Предмет" FontSize="11" Margin="0,0,0,2"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ComboBox ItemsSource="{Binding Subjects}" DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" />

        <TextBlock Text="Отметьте заметки, которые войдут в отчёт — каждая станет разделом второго уровня."
                   FontSize="11" TextWrapping="Wrap" Margin="0,10,0,6"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" HorizontalAlignment="Left" Margin="0,4,0,4"
                         Visibility="{Binding IsBusy, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />

        <TextBlock Text="У этого предмета пока нет заметок." FontSize="12" Margin="0,4,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding HasNotes, Converter={x:Static conv:InverseBooleanToVisibilityConverter.Instance}}" />

        <ListBox ItemsSource="{Binding Notes}" MaxHeight="320" BorderThickness="0" Background="Transparent"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 HorizontalContentAlignment="Stretch"
                 Visibility="{Binding HasNotes, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NoteSelectionRowViewModel}">
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Excerpt}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding UpdatedText}" FontSize="10"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>

</UserControl>
