<UserControl x:Class="StudComp.Views.ReportForge.Dialogs.ProfileEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:controls="clr-namespace:StudComp.Controls"
             xmlns:vm="clr-namespace:StudComp.ViewModels.ReportForge"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProfileEditorViewModel}"
             d:DesignHeight="620" d:DesignWidth="900">

    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel>

                <TextBlock Text="Название профиля" Style="{StaticResource Lbl}" />
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <ui:CardExpander Header="Шрифт и абзац" IsExpanded="True" ContentPadding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Шрифт" Style="{StaticResource Lbl}" />
                        <ui:TextBox Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Times New Roman" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Кегль, пт" Style="{StaticResource Lbl}" />
                                <ui:NumberBox Value="{Binding FontSizePt, Mode=TwoWay}" Minimum="8" Maximum="72"
                                              SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Межстрочный интервал" Style="{StaticResource Lbl}" />
                                <ui:NumberBox Value="{Binding LineSpacing, Mode=TwoWay}" Minimum="1" Maximum="3"
                                              SmallChange="0.05" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Абзацный отступ, см" Style="{StaticResource Lbl}" />
                                <ui:NumberBox Value="{Binding ParagraphIndentCm, Mode=TwoWay}" Minimum="0" Maximum="5"
                                              SmallChange="0.05" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Выравнивание текста" Style="{StaticResource Lbl}" />
                                <ComboBox ItemsSource="{Binding Alignments}" DisplayMemberPath="Display"
                                          SelectedItem="{Binding SelectedBodyAlignment, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Маркер пунктов списка" Style="{StaticResource Lbl}" />
                        <ui:TextBox Text="{Binding BulletMarker, UpdateSourceTrigger=PropertyChanged}"
                                    MaxLength="3" PlaceholderText="–" Width="80" HorizontalAlignment="Left" />
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander Header="Поля страницы, мм" IsExpanded="True" ContentPadding="14" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Левое" Style="{StaticResource Lbl}" />
                            <ui:NumberBox Value="{Binding MarginLeft, Mode=TwoWay}" Minimum="0" Maximum="100"
                                          SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Правое" Style="{StaticResource Lbl}" />
                            <ui:NumberBox Value="{Binding MarginRight, Mode=TwoWay}" Minimum="0" Maximum="100"
                                          SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Верхнее" Style="{StaticResource Lbl}" />
                            <ui:NumberBox Value="{Binding MarginTop, Mode=TwoWay}" Minimum="0" Maximum="100"
                                          SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Нижнее" Style="{StaticResource Lbl}" />
                            <ui:NumberBox Value="{Binding MarginBottom, Mode=TwoWay}" Minimum="0" Maximum="100"
                                          SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander>

                <ui:CardExpander Header="Заголовки разделов" IsExpanded="True" ContentPadding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding HeadingRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HeadingRuleRowViewModel}">
                                    <Border Margin="0,0,0,8" CornerRadius="6" Padding="10" BorderThickness="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Кегль, пт" Style="{StaticResource Lbl}" />
                                                    <ui:NumberBox Value="{Binding FontSizePt, Mode=TwoWay}" Minimum="8"
                                                                  Maximum="72" SpinButtonPlacementMode="Compact" />
                                                </StackPanel>
                                            </Grid>
                                            <WrapPanel>
                                                <ui:ToggleSwitch Content="Полужирный" Margin="0,0,16,0"
                                                                 IsChecked="{Binding Bold, Mode=TwoWay}" />
                                                <ui:ToggleSwitch Content="С новой страницы" Margin="0,0,16,0"
                                                                 IsChecked="{Binding PageBreakBefore, Mode=TwoWay}" />
                                                <ui:ToggleSwitch Content="ПРОПИСНЫЕ"
                                                                 IsChecked="{Binding UpperCase, Mode=TwoWay}" />
                                            </WrapPanel>
                                            <TextBlock Text="Выравнивание" Style="{StaticResource Lbl}" Margin="0,8,0,4" />
                                            <ComboBox ItemsSource="{Binding Alignments}" DisplayMemberPath="Display"
                                                      SelectedItem="{Binding SelectedAlignment, Mode=TwoWay}"
                                                      HorizontalAlignment="Left" MinWidth="180" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <ui:Button Appearance="Secondary" Margin="0,0,8,0" Icon="{ui:SymbolIcon Add24}"
                                       Content="Добавить уровень" Command="{Binding AddHeadingLevelCommand}"
                                       IsEnabled="{Binding CanAddHeadingLevel}" />
                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Subtract24}"
                                       Content="Убрать последний" Command="{Binding RemoveHeadingLevelCommand}"
                                       IsEnabled="{Binding CanRemoveHeadingLevel}" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander Header="Нумерация страниц" IsExpanded="True" ContentPadding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <ui:ToggleSwitch Content="Печатать номера страниц"
                                         IsChecked="{Binding PageNumberingEnabled, Mode=TwoWay}" Margin="0,0,0,8" />
                        <TextBlock Text="Положение номера" Style="{StaticResource Lbl}" />
                        <ComboBox ItemsSource="{Binding PageNumberPositions}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedPageNumberPosition, Mode=TwoWay}"
                                  HorizontalAlignment="Left" MinWidth="200" Margin="0,0,0,8"
                                  IsEnabled="{Binding PageNumberingEnabled}" />
                        <ui:ToggleSwitch Content="Титульный лист без номера"
                                         IsChecked="{Binding SkipTitlePage, Mode=TwoWay}"
                                         IsEnabled="{Binding PageNumberingEnabled}" />
                    </StackPanel>
                </ui:CardExpander>

                <ui:CardExpander Header="Оглавление" IsExpanded="False" ContentPadding="14" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="С уровня" Style="{StaticResource Lbl}" />
                            <ui:NumberBox Value="{Binding TocMinLevel, Mode=TwoWay}" Minimum="1" Maximum="9"
                                          SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="По уровень" Style="{StaticResource Lbl}" />
                            <ui:NumberBox Value="{Binding TocMaxLevel, Mode=TwoWay}" Minimum="1" Maximum="9"
                                          SpinButtonPlacementMode="Inline" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander>

                <ui:CardExpander Header="Листинги кода" IsExpanded="False" ContentPadding="14" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Моноширинный шрифт" Style="{StaticResource Lbl}" />
                        <ui:TextBox Text="{Binding CodeMonospaceFont, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Consolas" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Кегль относительно текста, пт" Style="{StaticResource Lbl}" />
                                <ui:NumberBox Value="{Binding CodeRelativeSize, Mode=TwoWay}" Minimum="-8" Maximum="8"
                                              SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Цвет подложки (RRGGBB)" Style="{StaticResource Lbl}" />
                                <ui:TextBox Text="{Binding CodeBackgroundHex, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="F5F5F5 или пусто" MaxLength="7" />
                            </StackPanel>
                        </Grid>
                        <ui:ToggleSwitch Content="Рамка вокруг листинга" IsChecked="{Binding CodeBoxed, Mode=TwoWay}" />
                    </StackPanel>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>

        <controls:ProfilePreview Grid.Column="2" VerticalAlignment="Top" />
    </Grid>

</UserControl>
