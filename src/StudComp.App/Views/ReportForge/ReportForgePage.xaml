<UserControl x:Class="StudComp.Views.ReportForge.ReportForgePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:StudComp.Views.ReportForge"
             xmlns:vm="clr-namespace:StudComp.ViewModels.ReportForge"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReportForgePageViewModel}">

    <Grid Margin="16,12,16,16">
        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Margin="{StaticResource TabStripHelpReserve}">
            <TabItem Header="Новый отчёт">
                <local:NewReportPage DataContext="{Binding NewReport}" />
            </TabItem>
            <TabItem Header="История">
                <local:ReportHistoryPage DataContext="{Binding History}" />
            </TabItem>
            <TabItem Header="Профили оформления">
                <local:ProfilesPage DataContext="{Binding Profiles}" />
            </TabItem>
        </TabControl>

        <!-- Помощник по разделу: кнопка накладкой у правого края полосы вкладок (см. Tabs.xaml). -->
        <ui:Button Style="{StaticResource TabStripHelpButton}" Command="{Binding ShowHelpCommand}" />
    </Grid>

</UserControl>
