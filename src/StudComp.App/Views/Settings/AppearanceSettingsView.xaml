<UserControl x:Class="StudComp.Views.Settings.AppearanceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AppearanceSettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{DynamicResource Space.Page.Padding}">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:SymbolIcon Symbol="Color24" FontSize="22" VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorPrimaryBrush}" />
                <TextBlock Text="Оформление" FontSize="22" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource SettingsCaption}" Margin="0,0,0,8"
                       Text="Тема, акцентный цвет, плотность и масштаб интерфейса. Всё применяется сразу." />

            <!-- Тема -->
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Тема" />
                        <TextBlock Style="{StaticResource SettingsCaption}" Text="Светлая, тёмная или синхронно с Windows." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" MinWidth="180" VerticalAlignment="Center"
                              ItemsSource="{Binding Themes}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Акцент -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsLabel}" Text="Акцентный цвет" />
                    <TextBlock Style="{StaticResource SettingsCaption}" Margin="0,2,0,10"
                               Text="Основной цвет кнопок, активных вкладок и подсветки. Винный — по умолчанию." />

                    <ListBox ItemsSource="{Binding AccentPresets}"
                             SelectedItem="{Binding SelectedAccent, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             IsEnabled="{Binding UseCustomAccent, Converter={x:Static conv:InverseBooleanConverter.Instance}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,10,10" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Ring" CornerRadius="10" Padding="3" BorderThickness="2"
                                                    BorderBrush="Transparent">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="22" Height="22" CornerRadius="11"
                                                            Background="{Binding Hex, Converter={x:Static conv:StringToBrushConverter.Instance}}" />
                                                    <TextBlock Text="{Binding Display}" Margin="8,0,6,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ColorPrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Свой цвет" VerticalAlignment="Center"
                                  IsChecked="{Binding UseCustomAccent, Mode=TwoWay}" />
                        <ui:TextBox Grid.Column="1" MaxWidth="140" HorizontalAlignment="Left" Margin="12,0,0,0"
                                    PlaceholderText="#8A1C2B"
                                    IsEnabled="{Binding UseCustomAccent}"
                                    Text="{Binding CustomAccentHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Плотность -->
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Плотность интерфейса" />
                        <TextBlock Style="{StaticResource SettingsCaption}"
                                   Text="Компактная уменьшает отступы — больше помещается на экране." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                              ItemsSource="{Binding Densities}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedDensity, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Масштаб -->
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Масштаб интерфейса" />
                        <TextBlock Style="{StaticResource SettingsCaption}"
                                   Text="Увеличивает или уменьшает всё приложение целиком, как «зум» в редакторе." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                              ItemsSource="{Binding FontScales}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedFontScale, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Анимации -->
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Анимации" />
                        <TextBlock Style="{StaticResource SettingsCaption}"
                                   Text="Плавные переходы между экранами и разделами. Выключение делает всё мгновенным." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding AnimationsEnabled, Mode=TwoWay}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
