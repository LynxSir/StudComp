<UserControl x:Class="StudComp.Views.Settings.CardsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:StudComp.Resources.Converters"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CardsSettingsViewModel}">

    <UserControl.Resources>

        <!-- Строка «подпись слева · контрол справа» — та же геометрия, что в разделе Архивариуса. -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="LastRow" TargetType="Grid" BasedOn="{StaticResource Row}">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{DynamicResource Space.Page.Padding}">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:SymbolIcon Symbol="Layer24" FontSize="22" VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorPrimaryBrush}" />
                <TextBlock Text="Картотека" FontSize="22" FontWeight="SemiBold" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource SettingsCaption}" Margin="0,0,0,10"
                       Text="Интервальное повторение, тренажёр и напоминания раздела «Картотека»." />

            <!-- ── Повторение ─────────────────────────────────────────────────────────────────── -->
            <TextBlock Text="Повторение" Style="{StaticResource SettingsGroupHeader}" />

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Интервальное повторение" />
                        <TextBlock Style="{StaticResource SettingsCaption}"
                                   Text="Очередь дня, счётчик на иконке раздела и напоминания." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding ReviewEnabled, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                   Text="Новых карточек в день" />
                        <ui:NumberBox Grid.Column="1" Width="130" VerticalAlignment="Center"
                                      Minimum="0" Maximum="999"
                                      Value="{Binding NewCardsPerDay, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                   Text="Повторений в день" />
                        <ui:NumberBox Grid.Column="1" Width="130" VerticalAlignment="Center"
                                      Minimum="1" Maximum="9999"
                                      Value="{Binding ReviewsPerDay, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                   Text="Потолок интервала, дней" />
                        <ui:NumberBox Grid.Column="1" Width="130" VerticalAlignment="Center"
                                      Minimum="1" Maximum="3650"
                                      Value="{Binding MaxIntervalDays, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource LastRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="Порядок очереди" />
                        <ComboBox Grid.Column="1" Width="210" VerticalAlignment="Center" DisplayMemberPath="Display"
                                  ItemsSource="{Binding QueueOrders}"
                                  SelectedItem="{Binding SelectedQueueOrder, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsCaption}" Margin="0,14,0,0"
                               Text="Без лимитов после недельного перерыва очередь вырастает до сотен карточек — и её просто закрывают." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingsLabel}"
                                       Text="Переучивать провалы в той же сессии" />
                            <TextBlock Style="{StaticResource SettingsCaption}"
                                       Text="Карточка, которую не вспомнили, вернётся через несколько показов, а не завтра." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding RelearnInSession, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                   Text="Через сколько минут повторить" />
                        <ui:NumberBox Grid.Column="1" Width="130" VerticalAlignment="Center"
                                      Minimum="1" Maximum="600"
                                      IsEnabled="{Binding RelearnInSession}"
                                      Value="{Binding RelearnMinutes, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource LastRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                   Text="Учебные сутки начинаются в" />
                        <ui:NumberBox Grid.Column="1" Width="130" VerticalAlignment="Center"
                                      Minimum="0" Maximum="23"
                                      Value="{Binding DayRolloverHour, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Style="{StaticResource SettingsCaption}" Margin="0,14,0,0"
                               Text="Ответ в час ночи считается вчерашним: иначе полуночная сессия обнуляет дневные лимиты посреди работы." />
                </StackPanel>
            </Border>

            <!-- ── Тренировка ─────────────────────────────────────────────────────────────────── -->
            <TextBlock Text="Тренировка" Style="{StaticResource SettingsGroupHeader}" />

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                   Text="Способ проверки по умолчанию" />
                        <ComboBox Grid.Column="1" Width="210" VerticalAlignment="Center" DisplayMemberPath="Display"
                                  ItemsSource="{Binding CheckModes}"
                                  SelectedItem="{Binding SelectedCheckMode, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                   Text="Показов каждой карточки в аврале" />
                        <ui:NumberBox Grid.Column="1" Width="130" VerticalAlignment="Center"
                                      Minimum="1" Maximum="10"
                                      Value="{Binding CramMinShows, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource LastRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingsLabel}"
                                       Text="Порог засчёта введённого ответа" />
                            <TextBlock Style="{StaticResource SettingsCaption}"
                                       Text="Ниже порога ответ считается неверным, выше — «почти верно» с правом засчитать." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Width="150" Minimum="0.3" Maximum="1" TickFrequency="0.05"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    Value="{Binding TypedAnswerThreshold, Mode=TwoWay}" />
                            <TextBlock Width="38" Margin="10,0,0,0" VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding TypedAnswerThreshold, StringFormat={}{0:0.00}}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <CheckBox Content="Показывать «наоборот» по умолчанию"
                              IsChecked="{Binding ReverseByDefault, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource SettingsCaption}" Margin="28,2,0,10"
                               Text="Сначала оборот, вопрос — назвать термин." />

                    <CheckBox Content="Писать будущий интервал на кнопках оценки"
                              IsChecked="{Binding ShowNextIntervalOnButtons, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource SettingsCaption}" Margin="28,2,0,10"
                               Text="«Хорошо · через 10 дней» — чтобы выбор был осознанным." />

                    <CheckBox Content="Тренировка влияет на расписание повторений"
                              IsChecked="{Binding PracticeAffectsScheduling, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource SettingsCaption}" Margin="28,2,0,0"
                               Text="Пробный экзамен расписание не двигает никогда — он измеряет, а не учит." />
                </StackPanel>
            </Border>

            <!-- ── Напоминания ────────────────────────────────────────────────────────────────── -->
            <TextBlock Text="Напоминания" Style="{StaticResource SettingsGroupHeader}" />

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingsLabel}" Text="Напоминать о повторении" />
                            <TextBlock Style="{StaticResource SettingsCaption}"
                                       Text="Раз в день, если очередь не пуста. Уважает тихие часы из раздела «Дедлайны и уведомления»." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding ReminderEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Grid Style="{StaticResource LastRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="Время напоминания" />
                        <ui:TextBox Grid.Column="1" Width="130" VerticalAlignment="Center"
                                    PlaceholderText="19:00" IsEnabled="{Binding ReminderEnabled}"
                                    Text="{Binding ReminderTimeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Поиск ──────────────────────────────────────────────────────────────────────── -->
            <TextBlock Text="Поиск" Style="{StaticResource SettingsGroupHeader}" />

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <CheckBox Content="Искать в теле (обороте) карточки"
                              IsChecked="{Binding SearchInBody, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource SettingsCaption}" Margin="28,2,0,10"
                               Text="Выключите, если ищете только по вопросам и терминам — так быстрее." />

                    <CheckBox Content="Искать в «Корзине»"
                              IsChecked="{Binding SearchInTrash, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource SettingsCaption}" Margin="28,2,0,0"
                               Text="Удалённые карточки всё ещё попадаются в общем поиске, а не только в самой корзине." />
                </StackPanel>
            </Border>

            <ui:CardExpander Style="{StaticResource AppExpander}" Header="Диагностика поиска" IsExpanded="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding IndexStateText}" Style="{StaticResource SettingsLabel}" />
                        <TextBlock Style="{StaticResource SettingsCaption}"
                                   Text="Перестроение нужно после восстановления из старого архива или ручной правки базы." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing Width="18" Height="18" Margin="0,0,10,0" IsIndeterminate="True"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsRebuilding, Converter={x:Static conv:BooleanToVisibilityConverter.Instance}}" />
                        <ui:Button Content="Перестроить индекс" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding RebuildIndexCommand}"
                                   IsEnabled="{Binding IsRebuilding, Converter={x:Static conv:InverseBooleanConverter.Instance}}" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander>

            <!-- ── Компактный режим ───────────────────────────────────────────────────────────── -->
            <TextBlock Text="Компактный режим" Style="{StaticResource SettingsGroupHeader}" />

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsCaption}" Margin="0,0,0,10"
                               Text="Маленькое окно-шпаргалка всегда поверх остальных — строка поиска и раскрытие ответа. Вызов — из раздела «Картотека» и из меню трея, закрытие — Esc." />

                    <Grid Style="{StaticResource LastRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingsLabel}" Text="Глобальная горячая клавиша" />
                            <TextBlock Style="{StaticResource SettingsCaption}"
                                       Text="Работает из любого приложения. Выключена по умолчанию: может молча конфликтовать с чем-то ещё." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding GlobalHotkeyEnabled, Mode=TwoWay}" />
                    </Grid>

                    <ui:CardExpander Style="{StaticResource AppExpander}" Header="Сочетание клавиш"
                                     IsExpanded="{Binding GlobalHotkeyEnabled, Mode=OneWay}" Margin="0,12,0,0">
                        <Grid IsEnabled="{Binding GlobalHotkeyEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="Сочетание клавиш" />
                            <ui:TextBox Grid.Column="1" Width="160" VerticalAlignment="Center"
                                        PlaceholderText="Ctrl+Alt+K"
                                        Text="{Binding GlobalHotkeyGestureText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </ui:CardExpander>
                </StackPanel>
            </Border>

            <!-- ── Данные ─────────────────────────────────────────────────────────────────────── -->
            <TextBlock Text="Данные" Style="{StaticResource SettingsGroupHeader}" />

            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource LastRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Хранить корзину, дней" />
                        <TextBlock Style="{StaticResource SettingsCaption}"
                                   Text="Удалённые карточки старше этого срока вычищаются насовсем раз в сутки." />
                    </StackPanel>
                    <ui:NumberBox Grid.Column="1" Width="130" VerticalAlignment="Center"
                                  Minimum="1" Maximum="3650"
                                  Value="{Binding CardTrashRetentionDays, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingsCaption}" Margin="0,0,0,10"
                               Text="Перенести картотеку на другой компьютер или сохранить её отдельно от общего бэкапа." />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="Экспортировать всю картотеку" Appearance="Secondary" Margin="0,0,8,0"
                                   Icon="{ui:SymbolIcon DocumentArrowRight24}"
                                   Command="{Binding ExportAllCommand}"
                                   IsEnabled="{Binding IsExportingOrImporting, Converter={x:Static conv:InverseBooleanConverter.Instance}}" />
                        <ui:Button Content="Импорт" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon ArrowImport24}"
                                   Command="{Binding ImportCommand}"
                                   IsEnabled="{Binding IsExportingOrImporting, Converter={x:Static conv:InverseBooleanConverter.Instance}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
