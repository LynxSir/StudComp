<UserControl x:Class="StudComp.Views.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:StudComp.ViewModels.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GeneralSettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{DynamicResource Space.Page.Padding}">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <ui:SymbolIcon Symbol="Settings24" FontSize="22" VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorPrimaryBrush}" />
                <TextBlock Text="Общие" FontSize="22" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource SettingsCaption}" Margin="0,0,0,8"
                       Text="Поведение запуска и закрытия, язык интерфейса, формат даты." />

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Сворачивать в трей при закрытии" />
                        <TextBlock Style="{StaticResource SettingsCaption}"
                                   Text="Фоновые сервисы (Архивариус, напоминания) продолжат работать после закрытия окна." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Язык интерфейса" />
                        <TextBlock Style="{StaticResource SettingsCaption}"
                                   Text="Пока доступен только русский — задел под локализацию." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center" IsEnabled="False"
                              SelectedIndex="0">
                        <ComboBoxItem Content="{Binding LanguageDisplay}" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource SettingsLabel}" Text="Формат даты" />
                        <TextBlock Style="{StaticResource SettingsCaption}"
                                   Text="Как показывать даты в интерфейсе." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" MinWidth="160" VerticalAlignment="Center"
                              ItemsSource="{Binding DateFormats}" DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedDateFormat, Mode=TwoWay}" />
                </Grid>
            </Border>

            <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,6,0,0"
                        Title="Окно"
                        Message="Приложение открывается развёрнутым, а при выходе запоминает размер и положение окна." />

        </StackPanel>
    </ScrollViewer>
</UserControl>
