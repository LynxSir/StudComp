<UserControl x:Class="StudComp.Views.Shell.Dialogs.MarkdownHelp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StudComp.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MarkdownHelpViewModel}"
             Width="640">

    <StackPanel>
        <TextBlock Text="Разметка Markdown: слева — что набрать, справа — что получится."
                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,6" />

                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,10,0"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <TextBlock Text="{Binding Syntax}" FontFamily="Consolas, Courier New, monospace"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Result}" FontSize="12"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />

                                        <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="12"
                                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Полный справочник символов движка формул: свёрнут, потому что нужен не при каждом
             открытии шпаргалки (правило AppExpander — раскрыт только основной путь). -->
        <ui:CardExpander Style="{StaticResource AppExpander}" Header="Все символы формул" IsExpanded="False">
            <ItemsControl ItemsSource="{Binding SymbolGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,6"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Command}" FontFamily="Consolas, Courier New, monospace"
                                                           FontSize="12" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding Glyph}" FontSize="13" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:CardExpander>
    </StackPanel>
</UserControl>
