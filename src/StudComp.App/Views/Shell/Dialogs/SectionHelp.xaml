<UserControl x:Class="StudComp.Views.Shell.Dialogs.SectionHelp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:StudComp.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SectionHelpViewModel}"
             d:DesignWidth="720">

    <!--
        Ширина обязана быть заметно меньше DialogMaxWidth вызова: у ContentDialog есть собственные
        поля и рамка, и содержимое ровно в DialogMaxWidth не помещается и обрезается справа.
    -->

    <UserControl.Resources>
        <!-- Пункт рельса тем: тот же вид, что у рельса разделов настроек (Phase 12.5). -->
        <Style x:Key="HelpRailItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Grid.Column="0" Width="3" CornerRadius="2"
                                        Background="{DynamicResource ColorPrimaryBrush}" Opacity="0" />
                                <ui:SymbolIcon x:Name="Ico" Grid.Column="2" Symbol="{Binding Icon}" FontSize="17"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="Txt" Grid.Column="3" Text="{Binding Title}" Margin="9,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="Accent" Property="Opacity" Value="1" />
                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource ColorPrimaryBrush}" />
                                <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Width="720" MinHeight="380" MaxHeight="520">
        <Grid.ColumnDefinitions>
            <!-- Хватает самой длинной теме («Профили оформления»), чтобы она не обрезалась. -->
            <ColumnDefinition Width="242" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" CornerRadius="10" Padding="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <ListBox ItemsSource="{Binding Topics}" SelectedItem="{Binding Current, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource HelpRailItem}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </Border>

        <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto"
                      DataContext="{Binding Current}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />

                <TextBlock Text="{Binding Lead}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ItemsControl ItemsSource="{Binding Points}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="5" Height="5" CornerRadius="3" Margin="2,7,10,0"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource ColorPrimaryBrush}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap"
                                               Margin="0,2,0,0" LineHeight="19"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
