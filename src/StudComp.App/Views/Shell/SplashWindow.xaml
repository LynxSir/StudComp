<Window x:Class="StudComp.Views.Shell.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True" Width="420" Height="220">

    <Border CornerRadius="12" Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{StaticResource ColorAccentGoldBrush}" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <Image Source="pack://application:,,,/Resources/Branding/logo-256.png"
                   Width="64" Height="64" HorizontalAlignment="Center" />
            <ui:TextBlock Text="Rubrica" FontTypography="Title" TextAlignment="Center" Margin="0,10,0,0"
                          Foreground="{StaticResource ColorPrimaryBrush}" />
            <ui:TextBlock Text="Подготовка к запуску…" FontTypography="Body" TextAlignment="Center"
                          Margin="0,6,0,18"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ProgressBar IsIndeterminate="True" Width="240" Height="4" />
        </StackPanel>
    </Border>

</Window>
