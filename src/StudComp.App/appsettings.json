{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Rubrica": {
    "Appearance": {
      "Theme": "Light",
      "Accent": "wine",
      "Density": "Normal",
      "FontScale": 1.0,
      "AnimationsEnabled": true
    },
    "General": {
      "RunOnWindowsStartup": false,
      "LaunchMinimized": false,
      "MinimizeToTrayOnClose": true,
      "Language": "ru",
      "DateFormat": "System"
    },
    "Workspace": {
      "StudyRootPath": "",
      "SubjectFolderTemplate": [ "Лекции", "Практики", "Проекты", "Отчёты", "Исходники" ],
      "OnRootChange": "DoNothing"
    },
    "Archivist": {
      "Enabled": false,
      "WatchStudyRoot": true,
      "WatchedFolders": [],
      "ArchiveRootFolder": "",
      "IgnoredPatterns": [ "*.tmp", "*.crdownload", "*.part", "*.partial", "*.download", "~$*", "*.lnk", "desktop.ini", "thumbs.db" ],
      "MinFileSizeBytes": 1024,
      "MinFileAgeSeconds": 2,
      "StabilityTimeoutSeconds": 60,
      "StabilityProbeIntervalMs": 500,
      "RegexMatchTimeoutMs": 200,
      "DeferredRetryInitialSeconds": 30,
      "DeferredRetryMaxAttempts": 6,
      "DeferredRetryPollSeconds": 30,
      "DeferredRetryMaxIntervalSeconds": 1800,
      "ReconciliationIntervalMinutes": 10,
      "ReconciliationStalePlannedMinutes": 5,
      "WatcherHealthCheckSeconds": 60,
      "SkipCloudPlaceholders": true,
      "DeadlineLinkSuggestionEnabled": true,
      "DeadlineLinkMinScore": 0.45,
      "DeadlineLinkWindowDays": 21,
      "UnsortedSuggestionsEnabled": true,
      "UnsortedSuggestionMinScore": 0.35,
      "UnsortedSuggestionMaxCandidates": 3
    },
    "Notifications": {
      "RemindersEnabled": true,
      "RemindMinutesBefore": 30,
      "QuietHoursEnabled": false,
      "QuietHoursStart": "22:00:00",
      "QuietHoursEnd": "08:00:00",
      "SoundEnabled": true,
      "UnsortedReminderDays": 0
    },
    "UserProfile": {
      "FullName": null,
      "Group": null,
      "University": null,
      "Faculty": null,
      "Department": null,
      "City": null
    },
    "ReportForge": {
      "OutputFolder": "",
      "OpenAfterGenerate": true,
      "DefaultWorkType": "Отчёт по лабораторной работе",
      "PreferSubjectSubfolder": true,
      "DefaultProfileId": null
    },
    "Diagnostics": {
      "PerformanceLoggingEnabled": false,
      "ProbeIntervalMinutes": 5
    },
    "Update": {
      "AutoCheckOnStartup": true,
      "GithubRepoUrl": "https://github.com/LynxSir/StudComp",
      "GithubToken": "",
      "IncludePrerelease": false
    },
    "Cards": {
      "ReviewEnabled": true,
      "NewCardsPerDay": 20,
      "ReviewsPerDay": 200,
      "MaxIntervalDays": 365,
      "QueueOrder": "DueFirst",
      "RelearnFailedInSameSession": true,
      "RelearnMinutes": 10,
      "NewCardShare": 0.25,
      "DayRolloverHour": 4,
      "SchedulerName": "sm2",
      "DefaultCheckMode": "SelfAssessment",
      "ReverseByDefault": false,
      "TypedAnswerThreshold": 0.8,
      "ShowNextIntervalOnButtons": true,
      "PracticeAffectsScheduling": false,
      "DefaultExamCardCount": 40,
      "CramMinShows": 3,
      "ReminderEnabled": false,
      "ReminderTime": "19:00:00",
      "SearchInBody": true,
      "SearchInTrash": false,
      "GlobalHotkeyEnabled": false,
      "GlobalHotkeyGesture": "Ctrl+Alt+K"
    },
    "Data": {
      "ActivityRetentionDays": 90,
      "ActivityRetentionKeepCount": 500,
      "OperationLogRetentionDays": 180,
      "CardTrashRetentionDays": 30
    }
  }
}
