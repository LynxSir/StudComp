<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Extensions-абстракции выровнены по 10.0.9, как в StudComp.Data. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
    <!-- IMessenger — шина сообщений между модулями (ARCHITECTURE §11.4, ADR §16.52). Версия
         выровнена по StudComp.App, где пакет уже был ради ObservableObject/RelayCommand. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Serilog: конфигурация файлового логгера с ротацией (ARCHITECTURE §11.1). -->
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StudComp.Core\StudComp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StudComp.Infrastructure.Tests" />
    <!-- Тесты Архивариуса и комбайна отчётов гоняют реальную файловую систему, а не подставную. -->
    <InternalsVisibleTo Include="StudComp.Modules.Archivist.Tests" />
    <InternalsVisibleTo Include="StudComp.Modules.Organizer.Tests" />
    <InternalsVisibleTo Include="StudComp.Modules.ReportForge.Tests" />
    <InternalsVisibleTo Include="StudComp.Modules.Cards.Tests" />
  </ItemGroup>

</Project>
