      <w:r>
        <w:t xml:space="preserve">Формулы и переносы строк</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t xml:space="preserve">Формула в строке: </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Consolas" w:hAnsi="Consolas" w:cs="Consolas" />
          <w:i />
          <w:iCs />
        </w:rPr>
        <w:t xml:space="preserve">E = mc^2</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> — часть обычного абзаца.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t xml:space="preserve">Выключная формула идёт отдельным абзацем:</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Consolas" w:hAnsi="Consolas" w:cs="Consolas" />
          <w:i />
          <w:iCs />
        </w:rPr>
        <w:t xml:space="preserve">\int_a^b f(x)dx = F(b) - F(a)</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t xml:space="preserve">Абзац с одиночным переносом строки: вторая строка того же абзаца, третья строка того же абзаца.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t xml:space="preserve">Абзац с жёстким переносом:</w:t>
      </w:r>
      <w:r>
        <w:br />
      </w:r>
      <w:r>
        <w:t xml:space="preserve">эта строка начинается после явного разрыва.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t xml:space="preserve">Дробь и корень в строке: </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Consolas" w:hAnsi="Consolas" w:cs="Consolas" />
          <w:i />
          <w:iCs />
        </w:rPr>
        <w:t xml:space="preserve">\frac{a+b}{2}</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> и </w:t>
      </w:r>
      <w:r>
        <w:rPr>
          <w:rFonts w:ascii="Consolas" w:hAnsi="Consolas" w:cs="Consolas" />
          <w:i />
          <w:iCs />
        </w:rPr>
        <w:t xml:space="preserve">\sqrt{x^2 + y^2}</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve">.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t xml:space="preserve">Греческие буквы и отношения: </w:t>
      </w:r>
